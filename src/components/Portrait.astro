---
// public/portrait.png is a pre-dithered halftone cutout (black dots on
// transparency) generated by scripts/portrait/halftone.swift.
// Light mode: dots sit straight on the page with a faint dot backdrop.
// Dark mode: the card turns paper-light and the dots stay black — a
// printed-photo look, instead of inverting the face.
import { existsSync } from "node:fs";
import { join } from "node:path";

const hasPhoto = existsSync(join(process.cwd(), "public/portrait.png"));
---

<div class="reveal relative aspect-square w-full max-w-[18rem] select-none">
  {
    hasPhoto ? (
      <div class="relative h-full w-full overflow-hidden dark:bg-ink">
        <div
          aria-hidden="true"
          class="halftone-fine absolute inset-0 opacity-[0.14] dark:[--halftone:rgba(10,10,10,0.9)] [mask-image:radial-gradient(circle_at_50%_38%,#000_30%,transparent_78%)]"
        />
        <img
          src="/portrait.png"
          alt="Christian Josef Aquino"
          width="768"
          height="768"
          fetchpriority="high"
          class="relative h-full w-full object-contain object-bottom"
        />
      </div>
    ) : (
      <div
        class="mask-portrait relative grid h-full w-full place-items-center overflow-hidden"
        role="img"
        aria-label="Placeholder portrait"
      >
        <div class="halftone absolute inset-0 opacity-[0.18]" aria-hidden="true" />
        <div
          class="halftone-fine absolute inset-x-0 bottom-0 top-1/3 opacity-30"
          aria-hidden="true"
        />
        <span class="relative font-pixel text-[3.4rem] leading-none text-ink/70">
          CJA
        </span>
      </div>
    )
  }
</div>
