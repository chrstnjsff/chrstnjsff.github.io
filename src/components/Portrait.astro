---
// Drop a photo at public/portrait.png (square, ideally already 1-bit dithered
// black & white) and it renders in place of the monogram placeholder.
// Everything else about the frame stays the same.
import { existsSync } from "node:fs";

const hasPhoto = existsSync(new URL("../../public/portrait.png", import.meta.url));
---

<div class="reveal relative aspect-square w-full max-w-[18rem] select-none">
  {
    hasPhoto ? (
      <img
        src="/portrait.png"
        alt="Christian Josef Aquino"
        width="576"
        height="576"
        class="mask-portrait h-full w-full object-cover contrast-125 grayscale dark:invert"
      />
    ) : (
      <div
        class="mask-portrait relative grid h-full w-full place-items-center overflow-hidden"
        role="img"
        aria-label="Placeholder portrait"
      >
        <div class="halftone absolute inset-0 opacity-[0.18]" aria-hidden="true" />
        <div
          class="halftone-fine absolute inset-x-0 bottom-0 top-1/3 opacity-30"
          aria-hidden="true"
        />
        <span class="relative font-pixel text-[3.4rem] leading-none text-ink/70">
          CJA
        </span>
      </div>
    )
  }
</div>
