---
// Wordmark: a shell prompt running `whoami` — the command that answers
// exactly what this page answers. Set in Geist Pixel Square, the site's
// display face, so it reads as part of the console language.
interface Props {
  /** Font size in px. */
  size?: number;
  class?: string;
}
const { size = 18, class: className = "" } = Astro.props;
---

<span
  class={`inline-flex items-baseline gap-[0.45em] whitespace-nowrap font-pixel leading-none ${className}`}
  style={`font-size: ${size}px`}
>
  <span class="text-muted" aria-hidden="true">&gt;</span>
  <span>whoami</span>
</span>
