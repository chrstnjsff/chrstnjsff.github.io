---
interface Props {
  /** Outcome shown as a chip after the sentence, e.g. "99.95% uptime". */
  metric?: string;
}
const { metric } = Astro.props;
---

<li class="flex gap-3 text-body text-muted">
  <span class="mt-[0.8em] h-px w-3 shrink-0 bg-line/25" aria-hidden="true"></span>
  <span>
    <slot />{
      metric && (
        <>
          {" "}
          <strong class="metric-chip">{metric}</strong>
        </>
      )
    }
  </span>
</li>
