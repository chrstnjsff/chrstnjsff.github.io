---
// GitHub contribution calendar as a grid of accent squares.
// Data comes from github.com's public contributions fragment at build
// time: no token, no client-side third-party requests. The deploy
// workflow rebuilds on a daily cron so the graph stays current.
import { SITE } from "../config/site";

interface Day {
  row: number;
  col: number;
  level: number;
}

const USER = SITE.githubUser;

let days: Day[] = [];
let total = 0;
let cols = 0;

try {
  // A stalled GitHub must not hold up the daily build: give up after 15s.
  const res = await fetch(`https://github.com/users/${USER}/contributions`, {
    signal: AbortSignal.timeout(15_000),
  });
  if (res.ok) {
    const html = await res.text();

    // Day cells: id encodes the grid position, data-level the intensity.
    const cellRe =
      /id="contribution-day-component-(\d+)-(\d+)"[^>]*data-level="(\d)"|data-level="(\d)"[^>]*id="contribution-day-component-(\d+)-(\d+)"/g;
    for (const m of html.matchAll(cellRe)) {
      const row = Number(m[1] ?? m[5]);
      const col = Number(m[2] ?? m[6]);
      const level = Number(m[3] ?? m[4]);
      days.push({ row, col, level });
      if (col + 1 > cols) cols = col + 1;
    }

    // Per-day counts live in the tooltips; the year total is their sum.
    for (const m of html.matchAll(/>(\d+) contributions? on /g)) {
      total += Number(m[1]);
    }
  }
} catch {
  days = [];
}

const ok = days.length > 180;
const totalLabel = total.toLocaleString("en-US");
---

{
  ok ? (
    <div class="gh">
      <div class="gh-scroll" data-contrib-scroll>
        <div
          class="gh-grid"
          style={`grid-template-columns: repeat(${cols}, minmax(0, 1fr))`}
          role="img"
          aria-label={`GitHub contribution graph: ${totalLabel} contributions in the last year`}
        >
          {days.map((d) => (
            <i data-l={d.level} style={`grid-area: ${d.row + 1} / ${d.col + 1}`} />
          ))}
        </div>
      </div>
      <div class="gh-foot">
        <span>{totalLabel} contributions in the last year</span>
        <span class="gh-legend" aria-hidden="true">
          less
          {[0, 1, 2, 3, 4].map((l) => (
            <i data-l={l} />
          ))}
          more
        </span>
      </div>
    </div>
  ) : (
    <p class="gh-empty">
      The contribution graph did not load at build time.{" "}
      <a href={`https://github.com/${USER}`} target="_blank" rel="noopener" class="link-ul">
        See it on GitHub
      </a>
      .
    </p>
  )
}

<script is:inline>
  // On a phone the year is wider than the screen: open on the most
  // recent weeks, where the activity that matters is.
  (function () {
    var el = document.querySelector("[data-contrib-scroll]");
    if (el) el.scrollLeft = el.scrollWidth;
  })();
</script>
