---
// Halftone flappy — everything on the canvas is drawn as dots, in the
// site's own ink/bg palette (read from CSS vars at runtime, so it is
// theme-aware). Vanilla JS, no deps; the loop pauses offscreen.
---

<div class="reveal d1">
  <div class="relative">
    <canvas
      id="flappy"
      tabindex="0"
      class="block h-64 w-full touch-manipulation border border-line/15"
      aria-label="Halftone flappy game. Guide the pod past the pipelines. Press space, up arrow, click, or tap to flap."
    ></canvas>

    <!-- score, Geist Pixel, top-right -->
    <div
      id="flappy-score"
      class="tnum pointer-events-none absolute right-3 top-2.5 font-pixel text-[17px] leading-none text-ink"
      style="display: none"
      aria-hidden="true"
    >
      0
    </div>

    <!-- idle hint -->
    <div
      id="flappy-hint"
      class="pointer-events-none absolute inset-x-0 bottom-9 flex justify-center"
      aria-hidden="true"
    >
      <p class="bg-bg/80 px-3 py-1 font-mono text-[12px] text-muted">
        space / click / tap to start
      </p>
    </div>

    <!-- game over -->
    <div
      id="flappy-over"
      class="pointer-events-none absolute inset-0 place-items-center"
      style="display: none"
      aria-hidden="true"
    >
      <div
        class="border border-line/15 border-t-2 border-t-accent bg-bg/95 px-8 py-5 text-center backdrop-blur-sm"
      >
        <p id="flappy-final" class="tnum font-pixel text-[24px] leading-none text-ink">0</p>
        <p class="tnum mt-2.5 font-mono text-[12px] text-muted">
          best <span id="flappy-best">0</span>
        </p>
        <p class="mt-3 font-mono text-[12px] text-muted">
          again? <span class="text-ink">space / tap</span>
        </p>
      </div>
    </div>
  </div>

  <p class="mt-3 flex items-baseline justify-between gap-4 font-mono text-[12px] text-muted">
    <span>guide the pod past the pipelines.</span>
    <span class="tnum">best <span id="flappy-best-idle">0</span></span>
  </p>
</div>

<script is:inline>
  (function () {
    var canvas = document.getElementById("flappy");
    if (!canvas || !canvas.getContext) return;
    var ctx = canvas.getContext("2d");

    var scoreEl = document.getElementById("flappy-score");
    var hintEl = document.getElementById("flappy-hint");
    var overEl = document.getElementById("flappy-over");
    var finalEl = document.getElementById("flappy-final");
    var bestEl = document.getElementById("flappy-best");
    var bestIdleEl = document.getElementById("flappy-best-idle");

    var reduce = window.matchMedia("(prefers-reduced-motion: reduce)");

    // ---- palette from CSS vars (theme-aware) ------------------------
    var ink = "10 10 10";
    var bg = "255 255 255";

    function readColors() {
      var cs = getComputedStyle(document.documentElement);
      ink = (cs.getPropertyValue("--ink") || ink).trim();
      bg = (cs.getPropertyValue("--bg") || bg).trim();
    }

    function rgba(triplet, a) {
      return "rgba(" + triplet.split(/\s+/).join(",") + "," + a + ")";
    }

    // ---- tuning ------------------------------------------------------
    var SPEED = 132; // px/s  (~2.2 px/frame @60fps)
    var GRAV = 1400; // px/s^2
    var FLAP = -360; // px/s impulse
    var SPAWN = 1.6; // s between pipes
    var GAP_FRAC = 0.34;
    var PW = 24; // pipe width
    var BIRD_R = 7;
    var GRACE = 2; // forgiving hitbox

    // ---- state -------------------------------------------------------
    var state = "idle"; // idle | play | over
    var W = 0, H = 0, dpr = 1, groundY = 0;
    var bird = { x: 90, y: 100, vy: 0 };
    var pipes = [];
    var score = 0;
    var best = 0;
    try {
      best = Number(localStorage.getItem("flappy-best")) || 0;
    } catch (e) {}
    var spawnT = 0, wingT = 0, wingUp = false, bobT = 0, distX = 0;
    var shakeT = 0, overAt = 0;
    var rafId = 0, lastT = 0, visible = false;

    bestIdleEl.textContent = String(best);
    bestEl.textContent = String(best);

    // ---- bird dot cluster (~14px halftone disc + 2-frame wing) ------
    var BODY = [[0, 0, 2.3]];
    var i, a;
    for (i = 0; i < 6; i++) {
      a = (i / 6) * Math.PI * 2;
      BODY.push([Math.cos(a) * 3.6, Math.sin(a) * 3.6, 1.7]);
    }
    for (i = 0; i < 10; i++) {
      a = (i / 10) * Math.PI * 2 + 0.3;
      BODY.push([Math.cos(a) * 6.4, Math.sin(a) * 6.4, 1.15]);
    }
    var WING_UP = [[-3, -4.5, 1.6], [-5.5, -7, 1.35], [-8, -9.5, 1.1]];
    var WING_DN = [[-3, 4.5, 1.6], [-5.5, 7, 1.35], [-8, 9.5, 1.1]];

    // ---- lattice cache (faint dot field, 13px pitch) ----------------
    var lattice = document.createElement("canvas");

    function buildLattice() {
      lattice.width = Math.max(1, Math.round(W * dpr));
      lattice.height = Math.max(1, Math.round(H * dpr));
      var lc = lattice.getContext("2d");
      lc.setTransform(dpr, 0, 0, dpr, 0, 0);
      lc.clearRect(0, 0, W, H);
      lc.fillStyle = rgba(ink, 0.13);
      for (var y = 6.5; y < H; y += 13) {
        for (var x = 6.5; x < W; x += 13) {
          lc.beginPath();
          lc.arc(x, y, 1, 0, 6.2832);
          lc.fill();
        }
      }
    }

    function resize() {
      dpr = Math.min(window.devicePixelRatio || 1, 2);
      W = canvas.clientWidth;
      H = canvas.clientHeight;
      canvas.width = Math.round(W * dpr);
      canvas.height = Math.round(H * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      groundY = H - 12;
      bird.x = Math.max(60, Math.round(W * 0.22));
      if (bird.y > groundY - BIRD_R) bird.y = groundY - BIRD_R;
      buildLattice();
      if (!rafId) draw();
    }

    // ---- drawing (dots only) ----------------------------------------
    function dot(x, y, r, style) {
      ctx.beginPath();
      ctx.arc(x, y, r, 0, 6.2832);
      ctx.fillStyle = style;
      ctx.fill();
    }

    function drawPipe(p) {
      var gapH = H * GAP_FRAC;
      var gapTop = p.gapY - gapH / 2;
      var gapBot = p.gapY + gapH / 2;
      var cols = [3, 9, 15, 21];
      var c, x, y, edge;
      for (c = 0; c < cols.length; c++) {
        x = p.x + cols[c];
        edge = c === 0 || c === cols.length - 1;
        var r = edge ? 2 : 1.25;
        var alpha = edge ? 0.85 : 0.45;
        for (y = 7; y < gapTop - 4; y += 6) dot(x, y, r, rgba(ink, alpha));
        for (y = gapBot + 4; y < groundY - 3; y += 6) dot(x, y, r, rgba(ink, alpha));
      }
      // pipe lips — a denser dotted rim at each gap edge
      for (x = p.x - 2; x <= p.x + PW + 2; x += 5) {
        if (gapTop > 10) dot(x, gapTop - 2, 2.1, rgba(ink, 0.9));
        dot(x, gapBot + 2, 2.1, rgba(ink, 0.9));
      }
    }

    function drawBird() {
      var yOff = 0;
      if (state === "idle" && !reduce.matches) yOff = Math.sin(bobT * 2.4) * 4;
      var tilt = 0;
      if (state !== "idle") {
        tilt = Math.max(-0.35, Math.min(0.85, bird.vy / 600));
      }
      ctx.save();
      ctx.translate(bird.x, bird.y + yOff);
      ctx.rotate(tilt);
      var j, d;
      for (j = 0; j < BODY.length; j++) {
        d = BODY[j];
        dot(d[0], d[1], d[2], rgba(ink, 0.95));
      }
      var wing = wingUp ? WING_UP : WING_DN;
      for (j = 0; j < wing.length; j++) {
        d = wing[j];
        dot(d[0], d[1], d[2], rgba(ink, 0.9));
      }
      // eye — negative space, a bg-colored dot
      dot(2.6, -2, 1.25, rgba(bg, 1));
      ctx.restore();
    }

    function draw() {
      ctx.clearRect(0, 0, W, H);
      if (shakeT > 0 && !reduce.matches) {
        ctx.save();
        ctx.translate((Math.random() - 0.5) * 5, (Math.random() - 0.5) * 5);
      }
      ctx.drawImage(lattice, 0, 0, W, H);
      var k;
      for (k = 0; k < pipes.length; k++) drawPipe(pipes[k]);
      // ground — a scrolling dotted hairline
      var off = -(distX % 6);
      for (var x = off; x < W; x += 6) dot(x, groundY + 5, 1.1, rgba(ink, 0.5));
      drawBird();
      if (shakeT > 0 && !reduce.matches) ctx.restore();
    }

    // ---- game logic --------------------------------------------------
    function spawn() {
      var gapH = H * GAP_FRAC;
      var m = 26;
      var min = m + gapH / 2;
      var max = groundY - m - gapH / 2;
      pipes.push({
        x: W + 4,
        gapY: min + Math.random() * Math.max(1, max - min),
        passed: false,
      });
    }

    function die() {
      state = "over";
      overAt = performance.now();
      shakeT = reduce.matches ? 0 : 0.22;
      if (score > best) {
        best = score;
        try {
          localStorage.setItem("flappy-best", String(best));
        } catch (e) {}
      }
      finalEl.textContent = String(score);
      bestEl.textContent = String(best);
      bestIdleEl.textContent = String(best);
      scoreEl.style.display = "none";
      overEl.style.display = "grid";
    }

    function step(dt) {
      distX += SPEED * dt;
      bird.vy += GRAV * dt;
      bird.y += bird.vy * dt;
      if (bird.y < BIRD_R) {
        bird.y = BIRD_R;
        bird.vy = 0;
      }
      wingT += dt;
      if (wingT > 0.13) {
        wingT = 0;
        wingUp = !wingUp;
      }
      spawnT += dt;
      if (spawnT >= SPAWN) {
        spawnT = 0;
        spawn();
      }

      var gapH = H * GAP_FRAC;
      var r = BIRD_R - GRACE;
      var k, p;
      for (k = pipes.length - 1; k >= 0; k--) {
        p = pipes[k];
        p.x -= SPEED * dt;
        if (!p.passed && p.x + PW < bird.x - BIRD_R) {
          p.passed = true;
          score++;
          scoreEl.textContent = String(score);
        }
        if (p.x + PW < -8) {
          pipes.splice(k, 1);
          continue;
        }
        // circle vs the two pipe rects
        if (bird.x + r > p.x && bird.x - r < p.x + PW) {
          if (bird.y - r < p.gapY - gapH / 2 || bird.y + r > p.gapY + gapH / 2) {
            die();
            return;
          }
        }
      }

      if (bird.y + r >= groundY) {
        die();
      }
    }

    // ---- loop (pauses offscreen, idles only while animating) --------
    function needsLoop() {
      return (
        state === "play" ||
        (state === "idle" && !reduce.matches) ||
        shakeT > 0
      );
    }

    function tick(t) {
      rafId = 0;
      if (!visible) return;
      var dt = lastT ? Math.min((t - lastT) / 1000, 0.033) : 0.016;
      lastT = t;
      if (state === "play") step(dt);
      if (state === "idle") bobT += dt;
      if (shakeT > 0) shakeT -= dt;
      draw();
      if (needsLoop()) rafId = requestAnimationFrame(tick);
    }

    function loopOn() {
      if (!rafId && visible && needsLoop()) {
        lastT = 0;
        rafId = requestAnimationFrame(tick);
      }
    }

    function loopOff() {
      if (rafId) {
        cancelAnimationFrame(rafId);
        rafId = 0;
      }
    }

    // ---- input -------------------------------------------------------
    function start() {
      pipes = [];
      score = 0;
      spawnT = 0;
      distX = 0;
      bird.y = Math.round(H * 0.45);
      bird.vy = FLAP;
      state = "play";
      hintEl.style.display = "none";
      overEl.style.display = "none";
      scoreEl.textContent = "0";
      scoreEl.style.display = "block";
      loopOn();
    }

    function input() {
      if (state === "play") {
        bird.vy = FLAP;
      } else if (state === "idle") {
        start();
      } else if (performance.now() - overAt > 350) {
        start();
      }
    }

    canvas.addEventListener("pointerdown", function (e) {
      e.preventDefault();
      try {
        canvas.focus({ preventScroll: true });
      } catch (err) {
        canvas.focus();
      }
      input();
    });

    // Scoped to the canvas — only fires while the canvas has focus, so
    // page scrolling is never hijacked.
    canvas.addEventListener("keydown", function (e) {
      if (e.code === "Space" || e.code === "ArrowUp") {
        e.preventDefault();
        input();
      }
    });

    // ---- lifecycle ---------------------------------------------------
    readColors();
    resize();
    bird.y = Math.round(H * 0.45);
    draw();

    window.addEventListener("resize", resize, { passive: true });

    new MutationObserver(function () {
      readColors();
      buildLattice();
      if (!rafId) draw();
    }).observe(document.documentElement, {
      attributes: true,
      attributeFilter: ["class"],
    });

    reduce.addEventListener("change", function () {
      if (!needsLoop()) {
        loopOff();
        draw();
      } else {
        loopOn();
      }
    });

    if ("IntersectionObserver" in window) {
      var io = new IntersectionObserver(
        function (entries) {
          visible = entries[0].isIntersecting;
          if (visible) {
            lastT = 0;
            loopOn();
          } else {
            loopOff();
          }
        },
        { threshold: 0.05 }
      );
      io.observe(canvas);
    } else {
      visible = true;
      loopOn();
    }
  })();
</script>
