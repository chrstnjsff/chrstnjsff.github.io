---
// Light is the default; this switch turns the Tokyo Night Storm theme on.
// Base.astro wires every [data-theme-toggle] and keeps them in sync.
---

<button type="button" class="side-btn" role="switch" aria-checked="false" data-theme-toggle>
  <i class="switch" aria-hidden="true"></i>
  <span>Dark mode</span>
</button>
