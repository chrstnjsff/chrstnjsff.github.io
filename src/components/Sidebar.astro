---
import ThemeSwitch from "./ThemeSwitch.astro";
import Logo from "./Logo.astro";

interface Props {
  /** Rendered inside the mobile overlay instead of the fixed rail. */
  mobile?: boolean;
}
const { mobile = false } = Astro.props;

const sections = [
  { href: "#about", label: "About" },
  { href: "#experience", label: "Experience" },
  { href: "#stack", label: "Stack" },
  { href: "#certifications", label: "Certifications" },
  { href: "#recommendations", label: "Recommendations" },
  { href: "#resources", label: "Resources" },
  { href: "#gear", label: "Gear" },
  { href: "#play", label: "Play" },
];
---

<a
  href="#top"
  class="shrink-0 p-2 -m-2 leading-none hover:opacity-60"
  aria-label="Christian Josef Aquino — back to top"
>
  <Logo size={19} />
</a>

<div class="mt-9 flex flex-1 flex-col gap-4 overflow-y-auto font-mono text-[13px]">
  <!-- profiles -->
  <div class="flex flex-col gap-2.5">
    <a
      href="https://github.com/chrstnjsff"
      target="_blank"
      rel="me noopener"
      class="inline-flex w-fit items-center gap-2.5 py-1.5 -my-1.5 text-muted hover:text-ink"
    >
      <svg viewBox="0 0 24 24" fill="none" class="h-[1.15em] w-[1.15em] shrink-0" aria-hidden="true">
        <path
          d="M12 3a9 9 0 00-2.85 17.54c.45.08.61-.2.61-.43v-1.5c-2.5.55-3.04-1.2-3.04-1.2-.41-1.05-1-1.33-1-1.33-.82-.56.06-.55.06-.55.9.06 1.38.93 1.38.93.8 1.38 2.1.98 2.62.75.08-.58.31-.98.57-1.2-2-.23-4.1-1-4.1-4.45 0-.98.35-1.79.93-2.42-.1-.23-.4-1.15.08-2.4 0 0 .75-.24 2.47.92a8.6 8.6 0 014.5 0c1.72-1.16 2.47-.92 2.47-.92.48 1.25.18 2.17.09 2.4.58.63.92 1.44.92 2.42 0 3.46-2.1 4.22-4.1 4.44.32.28.6.83.6 1.67v2.48c0 .24.16.52.62.43A9 9 0 0012 3z"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linejoin="round"></path>
      </svg>
      GitHub
    </a>
  </div>

  <div class="h-px bg-line/12"></div>

  <!-- page sections -->
  <div class="flex flex-col gap-2.5">
    {
      sections.map((s) => (
        <a
          href={s.href}
          data-nav-link
          class="inline-flex w-fit items-center gap-2.5 py-1.5 -my-1.5 text-muted hover:text-ink"
        >
          {s.label}
        </a>
      ))
    }
  </div>
</div>

<div class="mt-6 shrink-0">
  <ThemeSwitch idSuffix={mobile ? "-m" : ""} />

  <p class="mt-6 text-[12px] leading-relaxed text-muted">
    For work, infrastructure problems &amp; everything else, reach me at
  </p>
  <a
    href="mailto:chrstnjsff@gmail.com"
    class="mt-1.5 inline-flex w-fit items-center gap-2 py-1.5 -my-1.5 font-mono text-[13px] text-ink hover:text-muted"
  >
    <svg viewBox="0 0 24 24" fill="none" class="h-[1.15em] w-[1.15em] shrink-0" aria-hidden="true">
      <rect x="3" y="5" width="18" height="14" rx="2" stroke="currentColor" stroke-width="1.6"></rect>
      <path d="M4 7l8 6 8-6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path>
    </svg>
    chrstnjsff@gmail.com
  </a>
</div>
