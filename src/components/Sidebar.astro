---
// Site navigation, shared by the desktop rail and the phone menu sheet.
// Home sections link in place on the home page and through "/#id" elsewhere.
import ThemeSwitch from "./ThemeSwitch.astro";
import Icon, { type IconName } from "./Icon.astro";
import { SITE, type NavItem } from "../config/site";
import { getGuides } from "../lib/howto";
import { certs, experience, projects, reviews } from "../data/portfolio";

interface Props {
  /** In-page links for a guide's steps. */
  outline?: { title: string; items: NavItem[] };
}
const { outline } = Astro.props;

const path = Astro.url.pathname;
const isHome = path === "/";
const at = (id: string) => (isHome ? `#${id}` : `/#${id}`);
const guides = await getGuides();

interface Link {
  href: string;
  icon: IconName;
  label: string;
  count?: number;
  /** The link is the current page, not an in-page section. */
  page?: boolean;
}

const groups: { label: string; links: Link[] }[] = [
  {
    label: "Learn with me",
    links: [
      { href: "/how-to/", icon: "book", label: "How-to guides", count: guides.length, page: path.startsWith("/how-to/") },
      { href: at("resources"), icon: "link", label: "Resources" },
      { href: at("gear"), icon: "laptop", label: "Gear" },
      { href: at("reviews"), icon: "quote", label: "Reviews", count: reviews.length },
    ],
  },
  {
    label: "Portfolio",
    links: [
      { href: at("top"), icon: "user", label: "About" },
      { href: at("projects"), icon: "folder", label: "Projects", count: projects.length },
      { href: at("experience"), icon: "briefcase", label: "Experience", count: experience.length },
      { href: at("systems"), icon: "server", label: "What I run" },
      { href: at("certifications"), icon: "award", label: "Certifications", count: certs.length },
      { href: at("stack"), icon: "layers", label: "Stack" },
      { href: at("github"), icon: "github", label: "GitHub" },
    ],
  },
];
---

{
  outline && outline.items.length > 0 && (
    <>
      <p class="micro group-label">{outline.title}</p>
      <nav class="nav" aria-label={outline.title}>
        {outline.items.map((item, i) => (
          <a href={item.href} data-spy>
            <span class="step-n" aria-hidden="true">
              {String(i + 1).padStart(2, "0")}
            </span>
            <span>{item.label}</span>
          </a>
        ))}
      </nav>
    </>
  )
}

{
  groups.map((g) => (
    <>
      <p class="micro group-label">{g.label}</p>
      <nav class="nav" aria-label={g.label}>
        {g.links.map((l) => (
          <a
            href={l.href}
            aria-current={l.page ? "page" : undefined}
            data-spy={isHome && l.href.startsWith("#") ? "" : undefined}
          >
            <Icon name={l.icon} />
            <span>{l.label}</span>
            {l.count !== undefined && <span class="count">{l.count}</span>}
          </a>
        ))}
      </nav>
    </>
  ))
}

<div class="side-foot">
  <ThemeSwitch />
  <a class="side-btn" href={SITE.resumePath} download={SITE.resumeFilename}>
    <Icon name="file" />
    <span>Curriculum Vitae</span>
    <Icon name="ne" class="ext" size={14} />
  </a>
  <a class="side-btn" href="/contact/" aria-current={path.startsWith("/contact/") ? "page" : undefined}>
    <Icon name="send" />
    <span>Contact</span>
  </a>
</div>

<div class="collab">
  <p class="micro">Work &amp; collabs</p>
  <div class="collab-row">
    <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
    <button type="button" class="copy" data-copy-email={SITE.email} aria-label="Copy email address">
      <Icon name="copy" size={14} />
      <span class="done" aria-live="polite"></span>
    </button>
  </div>
</div>
