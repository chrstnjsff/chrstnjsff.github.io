---
import ThemeSwitch from "./ThemeSwitch.astro";
import Logo from "./Logo.astro";
import Icon from "./Icon.astro";
import { SITE, NAV_PAGES, type NavItem } from "../config/site";

interface Props {
  /** Rendered inside the mobile menu instead of the fixed rail. */
  mobile?: boolean;
  /** In-page links: home sections, or the steps of a guide. */
  outline?: { title: string; items: NavItem[] };
}
const { mobile = false, outline } = Astro.props;

const path = Astro.url.pathname;
const isHome = path === "/";
const isCurrentPage = (href: string) =>
  href === "/" ? isHome : path.startsWith(href);

// The rail is compact; the mobile menu gets full 44px rows.
const linkClass = mobile
  ? "inline-flex min-h-11 w-fit items-center gap-2.5 text-callout text-muted hover:text-ink"
  : "inline-flex w-fit items-center gap-2.5 py-1.5 -my-1.5 text-muted hover:text-ink";
const listGap = mobile ? "gap-0" : "gap-2.5";
---

{
  !mobile && (
    <a
      href={isHome ? "#top" : "/"}
      class="press -m-2 shrink-0 p-2 leading-none hover:opacity-60"
      aria-label={isHome ? `${SITE.name}, back to top` : `${SITE.name}, home`}
    >
      <Logo size={19} />
    </a>
  )
}

<!-- The rail scrolls its link list; the mobile menu scrolls as one panel. -->
<div
  class={`${mobile ? "" : "mt-9 -ml-5 min-h-0 flex-1 overflow-y-auto pl-5"} flex flex-col gap-5 font-mono text-footnote`}
>
  <!-- pages -->
  <ul class={`flex flex-col ${listGap}`}>
    {
      NAV_PAGES.map((p) => (
        <li>
          <a
            href={p.href}
            data-nav-link
            aria-current={isCurrentPage(p.href) ? "page" : undefined}
            class={linkClass}
          >
            {p.label}
          </a>
        </li>
      ))
    }
  </ul>

  {
    outline && outline.items.length > 0 && (
      <>
        <div class="h-px shrink-0 bg-line/12" aria-hidden="true" />
        <div>
          <p class="mb-3 text-caption uppercase tracking-wider text-muted">{outline.title}</p>
          <ul class={`flex flex-col ${listGap}`}>
            {outline.items.map((item) => (
              <li>
                <a href={item.href} data-nav-link data-spy class={linkClass}>
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      </>
    )
  }
</div>

<div class="mt-6 shrink-0">
  <ThemeSwitch idSuffix={mobile ? "-m" : ""} />

  <div class="mt-5 flex items-center gap-5 font-mono text-footnote">
    <a
      href={SITE.githubUrl}
      target="_blank"
      rel="me noopener"
      class={`${mobile ? "min-h-11" : "py-1.5 -my-1.5"} inline-flex items-center gap-2 text-muted hover:text-ink`}
    >
      <Icon name="github" />
      GitHub
    </a>
    <a
      href={SITE.linkedinUrl}
      target="_blank"
      rel="me noopener"
      class={`${mobile ? "min-h-11" : "py-1.5 -my-1.5"} inline-flex items-center gap-2 text-muted hover:text-ink`}
    >
      <Icon name="linkedin" />
      LinkedIn
    </a>
  </div>

  <p class="mt-5 text-caption text-muted">
    For work, infrastructure problems &amp; everything else, reach me at
  </p>
  <a
    href={`mailto:${SITE.email}`}
    class={`${mobile ? "min-h-11" : "mt-1.5 py-1.5 -my-1.5"} inline-flex w-fit items-center gap-2 font-mono text-footnote text-ink hover:text-muted`}
  >
    <Icon name="mail" />
    {SITE.email}
  </a>
</div>
