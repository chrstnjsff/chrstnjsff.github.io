---
// Web3Forms contact form, progressively enhanced:
// - Without JS it is a plain HTML POST; Web3Forms answers with a 303
//   to /contact/thanks/ (the `redirect` field, same-domain on the free plan).
// - With JS (src/scripts/contact.ts) it validates inline, posts JSON,
//   and swaps in a success panel without leaving the page.
import { SITE, WEB3FORMS_ACCESS_KEY, CONTACT_CAPTCHA } from "../config/site";

const reasons = [
  "General message",
  "Job opportunity",
  "Consulting or contract work",
  "Question about a guide",
];
const redirect = new URL("/contact/thanks/", SITE.url).href;
---

<div class="reveal d3">
  <form
    action="https://api.web3forms.com/submit"
    method="POST"
    class="card-tick p-5 sm:p-7"
    data-contact
    data-captcha={CONTACT_CAPTCHA}
    aria-describedby="contact-privacy"
  >
    <input type="hidden" name="access_key" value={WEB3FORMS_ACCESS_KEY} />
    <input type="hidden" name="subject" value={`New message from ${SITE.url.replace("https://", "")}`} />
    <input type="hidden" name="from_name" value={SITE.url.replace("https://", "")} />
    <input type="hidden" name="redirect" value={redirect} />
    <!-- honeypot: people never see or fill it, bots do -->
    <input
      type="checkbox"
      name="botcheck"
      class="hidden"
      style="display: none"
      tabindex="-1"
      autocomplete="off"
      aria-hidden="true"
    />

    <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
      <div>
        <label for="contact-name" class="field-label">Name</label>
        <input
          id="contact-name"
          name="name"
          type="text"
          autocomplete="name"
          required
          maxlength="100"
          class="field-input"
          aria-describedby="contact-name-error"
        />
        <p id="contact-name-error" class="field-error" hidden></p>
      </div>
      <div>
        <label for="contact-email" class="field-label">Email</label>
        <input
          id="contact-email"
          name="email"
          type="email"
          autocomplete="email"
          inputmode="email"
          spellcheck="false"
          required
          maxlength="254"
          class="field-input"
          aria-describedby="contact-email-error"
        />
        <p id="contact-email-error" class="field-error" hidden></p>
      </div>
    </div>

    <div class="mt-5">
      <label for="contact-reason" class="field-label">Topic</label>
      <div class="relative">
        <select id="contact-reason" name="reason" class="field-input field-select">
          {reasons.map((r) => <option value={r}>{r}</option>)}
        </select>
        <svg
          viewBox="0 0 24 24"
          fill="none"
          class="pointer-events-none absolute right-3 top-1/2 h-4 w-4 -translate-y-1/2 text-muted"
          aria-hidden="true"
        >
          <path d="M6 9l6 6 6-6" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
      </div>
    </div>

    <div class="mt-5">
      <label for="contact-message" class="field-label">Message</label>
      <textarea
        id="contact-message"
        name="message"
        rows="6"
        required
        minlength="10"
        maxlength="5000"
        spellcheck="true"
        class="field-input field-textarea"
        aria-describedby="contact-message-error"></textarea>
      <p id="contact-message-error" class="field-error" hidden></p>
    </div>

    {
      CONTACT_CAPTCHA === "hcaptcha" && (
        <div class="mt-5">
          <div class="h-captcha" data-captcha="true" />
          <noscript>
            <p class="mt-2 text-footnote text-muted">
              The spam check needs JavaScript. You can email me at{" "}
              <a class="link-ul text-ink" href={`mailto:${SITE.email}`}>{SITE.email}</a> instead.
            </p>
          </noscript>
        </div>
      )
    }

    <div class="contact-alert mt-5" role="alert" id="contact-alert"></div>

    <div class="mt-6 flex flex-col-reverse gap-4 sm:flex-row sm:items-center sm:justify-between">
      <p id="contact-privacy" class="text-caption text-muted">
        Delivered by Web3Forms. Your details are only used to reply to you.
      </p>
      <button type="submit" class="btn btn-primary press shrink-0" data-submit>
        Send message
      </button>
    </div>
    <p class="sr-only" role="status" aria-live="polite" id="contact-status"></p>
  </form>

  <div id="contact-success" class="card-tick p-5 sm:p-7" hidden>
    <p class="font-mono text-caption uppercase tracking-wider text-success">Sent</p>
    <h2 class="mt-3 text-title3 font-semibold text-ink outline-none" tabindex="-1" data-success-heading>
      Message sent
    </h2>
    <p class="mt-3 text-body text-muted" data-success-text>
      Thanks for reaching out. I'll reply to the email address you gave.
    </p>
    <button type="button" class="btn btn-secondary press mt-6" data-send-another>
      Send another message
    </button>
  </div>
</div>

{CONTACT_CAPTCHA === "hcaptcha" && <script is:inline src="https://web3forms.com/client/script.js" async defer />}

<script>
  import "../scripts/contact.ts";
</script>
