---
// Closing line on every page: the mark, the year and the three ways to
// reach me. Built daily by the deploy cron, so the year stays current.
import Logo from "./Logo.astro";
import Icon from "./Icon.astro";
import { SITE } from "../config/site";

const year = new Date().getFullYear();
---

<footer class="site-foot">
  <div class="foot">
    <div class="foot-l">
      <Logo markOnly size={22} />
      <p class="micro">© {year} {SITE.name}</p>
    </div>
    <div class="foot-r">
      <a href={SITE.linkedinUrl} target="_blank" rel="me noopener" aria-label="LinkedIn">
        <Icon name="linkedin" size={20} />
      </a>
      <a href={SITE.githubUrl} target="_blank" rel="me noopener" aria-label="GitHub">
        <Icon name="github" size={20} />
      </a>
      <a href={`mailto:${SITE.email}`} aria-label="Email">
        <Icon name="mail" size={20} />
      </a>
    </div>
  </div>
</footer>
