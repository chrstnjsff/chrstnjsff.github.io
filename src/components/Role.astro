---
interface Props {
  company: string;
  role: string;
  period: string;
  location: string;
  current?: boolean;
  delay?: string;
}
const { company, role, period, location, current = false, delay = "" } = Astro.props;
---

<article class={`reveal ${delay} group border-t border-line/10 py-7 first:border-t-0 first:pt-0`}>
  <header class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:justify-between sm:gap-6">
    <div class="flex items-baseline gap-2.5">
      <h3 class="text-[15px] font-medium tracking-tight text-ink">
        {company}
      </h3>
      {
        current && (
          <span class="inline-flex items-center gap-1.5 font-mono text-[12px] uppercase tracking-wider text-muted">
            <span class="relative flex h-1.5 w-1.5">
              <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-accent opacity-60" />
              <span class="relative inline-flex h-1.5 w-1.5 rounded-full bg-accent" />
            </span>
            now
          </span>
        )
      }
    </div>
    <p class="tnum shrink-0 font-mono text-[12px] uppercase tracking-wider text-muted">
      {period}
    </p>
  </header>

  <p class="mt-1 font-serif text-[15px] italic text-muted">
    {role} <span class="not-italic" aria-hidden="true">·</span> <span class="not-italic">{location}</span>
  </p>

  <ul class="mt-4 space-y-2.5">
    <slot />
  </ul>
</article>
