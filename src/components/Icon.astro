---
// Stroke icons drawn on a 24px grid, sized to the surrounding text.
interface Props {
  name: "github" | "linkedin" | "mail";
  class?: string;
}
const { name, class: className = "h-[1.15em] w-[1.15em]" } = Astro.props;
---

<svg viewBox="0 0 24 24" fill="none" class={`shrink-0 ${className}`} aria-hidden="true">
  {
    name === "github" && (
      <path
        d="M12 3a9 9 0 00-2.85 17.54c.45.08.61-.2.61-.43v-1.5c-2.5.55-3.04-1.2-3.04-1.2-.41-1.05-1-1.33-1-1.33-.82-.56.06-.55.06-.55.9.06 1.38.93 1.38.93.8 1.38 2.1.98 2.62.75.08-.58.31-.98.57-1.2-2-.23-4.1-1-4.1-4.45 0-.98.35-1.79.93-2.42-.1-.23-.4-1.15.08-2.4 0 0 .75-.24 2.47.92a8.6 8.6 0 014.5 0c1.72-1.16 2.47-.92 2.47-.92.48 1.25.18 2.17.09 2.4.58.63.92 1.44.92 2.42 0 3.46-2.1 4.22-4.1 4.44.32.28.6.83.6 1.67v2.48c0 .24.16.52.62.43A9 9 0 0012 3z"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linejoin="round"
      />
    )
  }
  {
    name === "linkedin" && (
      <>
        <rect x="3" y="3" width="18" height="18" rx="2.5" stroke="currentColor" stroke-width="1.5" />
        <path
          d="M8 10.5V16M12 16v-5.5M12 13a2.5 2.5 0 015 0v3"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
        />
        <circle cx="8" cy="7.6" r="0.9" fill="currentColor" />
      </>
    )
  }
  {
    name === "mail" && (
      <>
        <rect x="3" y="5" width="18" height="14" rx="2" stroke="currentColor" stroke-width="1.6" />
        <path
          d="M4 7l8 6 8-6"
          stroke="currentColor"
          stroke-width="1.6"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
      </>
    )
  }
</svg>
