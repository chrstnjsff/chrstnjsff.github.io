---
// One collapsible guide step. A native <details>, so it works without
// JavaScript, toggles with Enter/Space, and find-in-page can open it.
interface Props {
  /** Deep-link id: /how-to/<guide>/#<id> opens and scrolls to this step. */
  id: string;
  number: number;
  title: string;
  summary?: string;
  optional?: boolean;
}
const { id, number, title, summary, optional = false } = Astro.props;
---

<details id={id} class="disclosure card-tick scroll-mt-20">
  <summary class="flex min-h-11 cursor-pointer items-start gap-4 px-4 py-4 sm:px-5">
    <span class="tnum w-6 shrink-0 pt-px font-mono text-caption text-muted" aria-hidden="true">
      {String(number).padStart(2, "0")}
    </span>
    <span class="min-w-0 flex-1">
      <span class="flex flex-wrap items-baseline gap-x-2.5 gap-y-1">
        <span class="text-headline font-medium text-ink">
          <span class="sr-only">Step {number}: </span>{title}
        </span>
        {
          optional && (
            <span class="border border-line/15 px-1.5 font-mono text-caption uppercase tracking-wider text-muted">
              optional
            </span>
          )
        }
      </span>
      {summary && <span class="mt-1 block text-footnote text-muted">{summary}</span>}
    </span>
    <svg
      viewBox="0 0 24 24"
      fill="none"
      class="disclosure-chevron mt-1 h-4 w-4 shrink-0 text-muted"
      aria-hidden="true"
    >
      <path d="M6 9l6 6 6-6" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"></path>
    </svg>
  </summary>
  <div class="prose px-4 pb-6 pt-1 sm:pl-[3.75rem] sm:pr-5">
    <slot />
  </div>
</details>
