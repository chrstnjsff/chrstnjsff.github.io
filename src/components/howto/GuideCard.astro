---
import { guideHref, type Guide } from "../../lib/howto";

interface Props {
  guide: Guide;
  index: number;
  /** Heading level inside the card, to fit the surrounding outline. */
  level?: "h2" | "h3";
  delay?: string;
}
const { guide, index, level = "h2", delay = "" } = Astro.props;
const { data } = guide.entry;
const Heading = level;
const stepCount = guide.steps.length;
---

<a
  href={guideHref(guide.slug)}
  class={`reveal ${delay} press group card-tick card-lift block p-5 sm:p-6`}
>
  <div class="flex items-baseline justify-between gap-4">
    <p class="tnum font-mono text-caption uppercase tracking-wider text-muted">
      Guide {String(index + 1).padStart(2, "0")} · {data.platform}
    </p>
    <span
      class="shrink-0 font-mono text-caption text-muted transition-transform group-hover:translate-x-0.5 group-hover:text-ink"
      aria-hidden="true"
    >
      →
    </span>
  </div>
  <Heading class="mt-3 text-headline font-semibold text-ink">{data.title}</Heading>
  <p class="mt-2 text-footnote text-muted">{data.summary}</p>
  <p class="tnum mt-4 font-mono text-caption text-muted">
    {stepCount} {stepCount === 1 ? "step" : "steps"} · {data.duration.toLowerCase()}
  </p>
</a>
