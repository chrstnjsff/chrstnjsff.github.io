---
import { render } from "astro:content";
import Base from "../../layouts/Base.astro";
import Disclosure from "../../components/howto/Disclosure.astro";
import { getGuides, guideHref, type Guide } from "../../lib/howto";
import { SITE } from "../../config/site";

export async function getStaticPaths() {
  const guides = await getGuides();
  return guides.map((guide, i) => ({
    params: { guide: guide.slug },
    props: { guide, prev: guides[i - 1], next: guides[i + 1] },
  }));
}

interface Props {
  guide: Guide;
  prev?: Guide;
  next?: Guide;
}
const { guide, prev, next } = Astro.props;
const { data } = guide.entry;
const { Content: Intro } = await render(guide.entry);
const steps = await Promise.all(
  guide.steps.map(async (step) => ({ ...step, Content: (await render(step.entry)).Content })),
);

// Guide-level sources first, then any extra ones cited by single steps.
const seen = new Set<string>();
const sources = [data.sources, ...guide.steps.map((s) => s.entry.data.sources)]
  .flat()
  .filter((s) => !seen.has(s.url) && seen.add(s.url));

const url = new URL(guideHref(guide.slug), SITE.url).href;
const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "TechArticle",
    headline: data.title,
    description: data.summary,
    url,
    dateModified: data.verifiedOn.toISOString().slice(0, 10),
    proficiencyLevel: "Beginner",
    author: { "@type": "Person", name: SITE.name, url: SITE.url },
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: `${SITE.url}/` },
      { "@type": "ListItem", position: 2, name: "How-to", item: `${SITE.url}/how-to/` },
      { "@type": "ListItem", position: 3, name: data.title, item: url },
    ],
  },
];

const outline = {
  title: "Steps",
  items: guide.steps.map((s) => ({ href: `#${s.anchor}`, label: s.entry.data.nav ?? s.entry.data.title })),
};

const facts = [
  { k: "Platform", v: data.platform },
  { k: "Time", v: data.duration },
  { k: "Steps", v: String(guide.steps.length) },
];
---

<Base
  title={`${data.title} · ${SITE.name}`}
  description={data.summary}
  ogType="article"
  jsonLd={jsonLd}
  outline={outline}
>
  <div class="mx-auto max-w-2xl px-6 pb-16">
    <header class="pb-8 pt-14 sm:pt-20">
      <nav aria-label="Breadcrumb" class="reveal font-mono text-caption text-muted">
        <ol class="flex flex-wrap items-center gap-1.5">
          <li><a href="/how-to/" class="-my-3 inline-block py-3 hover:text-ink">~/how-to</a></li>
          <li aria-hidden="true">/</li>
          <li><span aria-current="page" class="text-ink">{guide.slug}</span></li>
        </ol>
      </nav>
      <h1 class="reveal d1 mt-5 text-title1 font-semibold text-ink sm:text-large">{data.title}</h1>
      <p class="reveal d2 mt-4 text-callout text-muted">{data.summary}</p>

      <dl
        class="reveal d3 mt-8 grid grid-cols-3 gap-x-4 gap-y-5 border-y border-line/12 py-5 sm:gap-x-6"
      >
        {
          facts.map((f) => (
            <div>
              <dt class="font-mono text-caption uppercase tracking-wider text-muted">{f.k}</dt>
              <dd class="tnum mt-1 text-footnote text-ink">{f.v}</dd>
            </div>
          ))
        }
      </dl>
    </header>

    <div class="reveal prose">
      <Intro />
    </div>

    <p class="reveal mt-6 font-mono text-caption text-muted">
      Verified with {data.verifiedWith.join(" · ")}
    </p>

    {
      data.prerequisites.length > 0 && (
        <aside
          class="reveal mt-8 border-l-2 border-accent/70 bg-surface px-5 py-4"
          aria-labelledby="before-you-start"
        >
          <h2 id="before-you-start" class="font-mono text-caption uppercase tracking-wider text-muted">
            Before you start
          </h2>
          <ul class="mt-3 space-y-1.5 text-footnote text-ink">
            {data.prerequisites.map((p) => (
              <li class="flex gap-3">
                <span class="mt-[0.7em] h-px w-2.5 shrink-0 bg-line/30" aria-hidden="true" />
                <span>{p}</span>
              </li>
            ))}
          </ul>
        </aside>
      )
    }

    <div class="mt-12 flex min-h-11 items-center gap-4">
      <h2 class="shrink-0 font-mono text-caption lowercase tracking-wide text-muted">
        <span aria-hidden="true">~/</span>steps
      </h2>
      <div class="h-px min-w-6 flex-1 bg-line/10" aria-hidden="true"></div>
      <button
        type="button"
        data-toggle-all
        hidden
        class="press -mr-2 inline-flex min-h-11 shrink-0 items-center px-2 font-mono text-caption text-muted hover:text-ink"
      >
        Expand all
      </button>
    </div>

    <ol class="mt-3 space-y-3">
      {
        steps.map((step, i) => (
          <li>
            <Disclosure
              id={step.anchor}
              number={i + 1}
              title={step.entry.data.title}
              summary={step.entry.data.summary}
              optional={step.entry.data.optional}
            >
              <step.Content />
            </Disclosure>
          </li>
        ))
      }
    </ol>

    <section class="mt-14" aria-labelledby="sources">
      <h2 id="sources" class="font-mono text-caption lowercase tracking-wide text-muted">
        <span aria-hidden="true">~/</span>sources
      </h2>
      <ul class="mt-4 space-y-1 text-footnote">
        {
          sources.map((s) => (
            <li>
              <a
                href={s.url}
                target="_blank"
                rel="noopener"
                class="link-ul -my-1 inline-block py-1 text-ink"
              >
                {s.label} <span class="text-muted" aria-hidden="true">↗</span>
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <nav
      class="mt-14 grid grid-cols-1 gap-3 sm:grid-cols-2"
      aria-label="More guides"
    >
      {
        prev ? (
          <a href={guideHref(prev.slug)} class="press group card-tick card-lift block p-4">
            <p class="font-mono text-caption text-muted">← Previous guide</p>
            <p class="mt-1.5 text-footnote font-medium text-ink">{prev.entry.data.title}</p>
          </a>
        ) : (
          <a href="/how-to/" class="press group card-tick card-lift block p-4">
            <p class="font-mono text-caption text-muted">← All guides</p>
            <p class="mt-1.5 text-footnote font-medium text-ink">How-to guides</p>
          </a>
        )
      }
      {
        next && (
          <a href={guideHref(next.slug)} class="press group card-tick card-lift block p-4 sm:text-right">
            <p class="font-mono text-caption text-muted">Next guide →</p>
            <p class="mt-1.5 text-footnote font-medium text-ink">{next.entry.data.title}</p>
          </a>
        )
      }
    </nav>

    <p id="howto-status" class="sr-only" role="status" aria-live="polite"></p>
  </div>
</Base>

<script>
  import "../../scripts/howto.ts";
</script>
