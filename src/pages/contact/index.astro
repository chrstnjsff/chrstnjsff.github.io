---
import Base from "../../layouts/Base.astro";
import ContactForm from "../../components/ContactForm.astro";
import Icon from "../../components/Icon.astro";
import { SITE } from "../../config/site";

const title = `Contact · ${SITE.name}`;
const description =
  "Get in touch with Christian Josef Aquino about DevOps, platform and reliability roles, consulting work, or the how-to guides.";

const channels = [
  {
    label: "Email",
    value: SITE.email,
    href: `mailto:${SITE.email}`,
    icon: "mail" as const,
    external: false,
  },
  {
    label: "LinkedIn",
    value: "in/cjosefaquino",
    href: SITE.linkedinUrl,
    icon: "linkedin" as const,
    external: true,
  },
  {
    label: "GitHub",
    value: `@${SITE.githubUser}`,
    href: SITE.githubUrl,
    icon: "github" as const,
    external: true,
  },
];
---

<Base title={title} description={description}>
  <div class="mx-auto max-w-2xl px-6 pb-16">
    <header class="pb-10 pt-14 sm:pt-20">
      <p class="reveal font-mono text-caption text-muted" aria-hidden="true">~/contact</p>
      <h1 class="reveal d1 mt-5 text-title1 font-semibold text-ink sm:text-large">Get in touch</h1>
      <p class="reveal d2 mt-4 max-w-xl text-callout text-muted">
        Open to conversations about platform engineering, reliability work, and anything involving
        Kubernetes at an awkward hour. Send a note below and it lands straight in my inbox.
      </p>
    </header>

    <ContactForm />

    <section class="mt-14" aria-labelledby="other-ways">
      <h2 id="other-ways" class="reveal font-mono text-caption lowercase tracking-wide text-muted">
        <span aria-hidden="true">~/</span>other ways to reach me
      </h2>
      <ul class="reveal d1 mt-4 divide-y divide-line/12 border-y border-line/12">
        {
          channels.map((c) => (
            <li>
              <a
                href={c.href}
                target={c.external ? "_blank" : undefined}
                rel={c.external ? "me noopener" : undefined}
                data-contact-email={c.icon === "mail" ? "" : undefined}
                class="group flex min-h-13 items-center gap-4 py-3 text-muted hover:text-ink"
              >
                <Icon name={c.icon} class="h-[1.1rem] w-[1.1rem]" />
                <span class="w-20 shrink-0 font-mono text-caption uppercase tracking-wider">{c.label}</span>
                <span class="min-w-0 flex-1 truncate font-mono text-footnote text-ink">{c.value}</span>
                <span
                  class="shrink-0 font-mono text-caption transition-transform group-hover:-translate-y-0.5 group-hover:translate-x-0.5"
                  aria-hidden="true"
                >
                  {c.external ? "↗" : "→"}
                </span>
              </a>
            </li>
          ))
        }
        <li>
          <a
            href={SITE.resumePath}
            download={SITE.resumeFilename}
            class="group flex min-h-13 items-center gap-4 py-3 text-muted hover:text-ink"
          >
            <svg viewBox="0 0 24 24" fill="none" class="h-[1.1rem] w-[1.1rem] shrink-0" aria-hidden="true">
              <path d="M7 3h7l4 4v14H7z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"></path>
              <path d="M14 3v4h4M10 12h5M10 15.5h5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path>
            </svg>
            <span class="w-20 shrink-0 font-mono text-caption uppercase tracking-wider">Resume</span>
            <span class="min-w-0 flex-1 truncate font-mono text-footnote text-ink">PDF, one page</span>
            <span class="shrink-0 font-mono text-caption" aria-hidden="true">↓</span>
          </a>
        </li>
      </ul>
    </section>
  </div>
</Base>
