---
import "../styles/home.css";
import Base from "../layouts/Base.astro";
import ContribGraph from "../components/ContribGraph.astro";
import Icon from "../components/Icon.astro";
import ProjectShot from "../components/ProjectShot.astro";
import { getGuides, guideHref } from "../lib/howto";
import { SITE } from "../config/site";
import {
  certs,
  companies,
  education,
  experience,
  gear,
  projects,
  reading,
  reviews,
  stack,
  stackMore,
  stats,
  systems,
  type Chip,
} from "../data/portfolio";

const title = `${SITE.name} · ${SITE.role}`;
const description =
  "Senior DevOps engineer in Mandaluyong, Metro Manila with 7+ years running production cloud infrastructure on AWS, Azure and GCP: 148 Kubernetes clusters at 99.95% uptime, OpenTofu and Terraform, GitOps and observability.";

const person = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: SITE.name,
  jobTitle: SITE.role,
  url: `${SITE.url}/`,
  image: `${SITE.url}/avatar.webp`,
  email: `mailto:${SITE.email}`,
  worksFor: [
    { "@type": "Organization", name: "Iron Mountain" },
    { "@type": "Organization", name: "Nova Virtual Solutions" },
  ],
  address: {
    "@type": "PostalAddress",
    addressLocality: SITE.location.locality,
    addressRegion: SITE.location.region,
    addressCountry: SITE.location.country,
  },
  sameAs: [SITE.githubUrl, SITE.linkedinUrl],
  knowsAbout: [
    "Kubernetes",
    "Terraform",
    "OpenTofu",
    "Amazon Web Services",
    "Google Cloud Platform",
    "Microsoft Azure",
    "Site Reliability Engineering",
    "CI/CD",
    "GitOps",
  ],
};

const guides = await getGuides();
const newest = guides.reduce((a, b) => (b.entry.data.verifiedOn > a.entry.data.verifiedOn ? b : a));

const chipColor = (c: Chip) => c.color ?? (c.icon ? `#${c.icon.hex}` : "currentColor");
---

<Base title={title} description={description} ogType="profile" jsonLd={[person]}>
  <div class="home wrap">
    <section class="hero" id="top" aria-labelledby="name">
      <div class="hero-grid">
        <img
          class="photo fade-up"
          src="/avatar.webp"
          alt={SITE.name}
          width="288"
          height="360"
          fetchpriority="high"
        />
        <div>
          <p class="micro fade-up d1">Senior DevOps engineer · Mandaluyong, PH</p>
          <h1 id="name" class="fade-up d1">{SITE.name}</h1>
          <p class="lede fade-up d2">
            I keep production running. At Iron Mountain I operate 148 Kubernetes clusters across AWS,
            Azure and GCP at 99.95% uptime, with every change shipped through OpenTofu and CI/CD.
          </p>
          <div class="links fade-up d3">
            <a href={SITE.linkedinUrl} target="_blank" rel="me noopener">
              <Icon name="linkedin" size={14} /> linkedin ↗
            </a>
            <a href={SITE.githubUrl} target="_blank" rel="me noopener">
              <Icon name="github" size={14} /> github ↗
            </a>
            <a href={`mailto:${SITE.email}`}><Icon name="mail" size={14} /> email ↗</a>
            <a href={SITE.resumePath} target="_blank" rel="noopener">
              <Icon name="file" size={14} /> cv ↗
            </a>
          </div>
        </div>
      </div>
    </section>

    <section class="proof fade-up d4" aria-labelledby="worked">
      <div class="proof-head">
        <h2 class="micro" id="worked">Where I've worked</h2>
        <button type="button" class="marquee-toggle" aria-pressed="false" data-marquee-toggle>
          <Icon name="pause" size={14} class="i-pause" />
          <Icon name="play" size={14} class="i-play" />
          <span class="sr-only">Pause the logo animation</span>
        </button>
      </div>
      <div class="marquee" data-marquee>
        <div class="track">
          {
            [false, true].map((copy) =>
              companies.map((c) => (
                <div class="co" aria-hidden={copy ? "true" : undefined}>
                  <img src={c.src} alt={copy ? "" : c.name} style={`height:${c.height}px`} />
                </div>
              ))
            )
          }
        </div>
      </div>
      <div class="stats">
        {
          stats.map((s) => (
            <div class="stat">
              <div class="stat-v">
                {s.v} <Icon name="ne" size={14} />
              </div>
              <div class="micro">
                {s.live && <span class="live" aria-hidden="true" />}
                {s.pre && <span class="long">{s.pre}</span>}
                {s.short}
                {s.long && <span class="long">{s.long}</span>}
              </div>
            </div>
          ))
        }
      </div>
    </section>

    <section class="sec" id="projects" aria-labelledby="projects-h">
      <div class="sec-head"><h2 class="micro" id="projects-h">01 · Projects</h2></div>
      <div class="cards">
        {
          projects.map((p) => (
            <article class={`card${"wide" in p && p.wide ? " wide" : ""}`}>
              <ProjectShot kind={p.shot} />
              <div class="card-body">
                <h3 class="card-t">{p.title}</h3>
                <p class="card-d">{p.desc}</p>
              </div>
            </article>
          ))
        }
      </div>
    </section>

    <section class="sec" id="experience" aria-labelledby="experience-h">
      <div class="sec-head">
        <h2 class="micro" id="experience-h">02 · Experience</h2>
        <a class="btn-sm press" href="/experience/">
          full history <Icon name="arrow" size={14} />
        </a>
      </div>
      <ul class="rows">
        {
          experience.map((e) => (
            <li>
              <span class="yr" title={e.period}>{e.year}</span>
              <div class="row-main">
                <span class="t">
                  <a href={`/experience/#${e.id}`}>{e.role}</a>
                </span>
                <span class="o">{e.org}</span>
              </div>
            </li>
          ))
        }
        <li>
          <span class="yr">{education.year}</span>
          <div class="row-main">
            <span class="t">
              <a href="/experience/#education">{education.role}</a>
            </span>
            <span class="o">{education.org}</span>
          </div>
        </li>
      </ul>
    </section>

    <section class="sec" id="systems" aria-labelledby="systems-h">
      <div class="sec-head"><h2 class="micro" id="systems-h">03 · What I run</h2></div>
      <ul class="two">
        {
          systems.map((s) => (
            <li>
              <h3>{s.title}</h3>
              <p>{s.meta}</p>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="sec" id="certifications" aria-labelledby="certs-h">
      <div class="sec-head"><h2 class="micro" id="certs-h">04 · Certifications</h2></div>
      <ul class="rows">
        {
          certs.map((c) => (
            <li>
              <span class="yr">{c.year}</span>
              <div class="row-main">
                <span class="t">
                  {c.href ? (
                    <a href={c.href} target="_blank" rel="noopener">
                      {c.title}
                    </a>
                  ) : (
                    c.title
                  )}
                  {c.badge && <span class="badge">{c.badge}</span>}
                </span>
                <span class="o">{c.issuer}</span>
              </div>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="sec" id="guides" aria-labelledby="guides-h">
      <div class="sec-head">
        <h2 class="micro" id="guides-h">05 · How-to guides</h2>
        <a class="btn-sm press" href="/how-to/">all {guides.length} <Icon name="arrow" size={14} /></a>
      </div>
      <ul class="rows">
        {
          guides.map((g) => (
            <li>
              <span class="yr">{g.entry.data.verifiedOn.getFullYear()}</span>
              <div class="row-main">
                <span class="t">
                  <a href={guideHref(g.slug)}>{g.entry.data.title}</a>
                  {g === newest && <span class="badge">new</span>}
                </span>
                <span class="o">{g.steps.length} steps · {g.entry.data.duration.toLowerCase()}</span>
              </div>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="sec" id="stack" aria-labelledby="stack-h">
      <div class="sec-head"><h2 class="micro" id="stack-h">06 · Tech stack</h2></div>
      <ul class="chips" data-chips>
        {
          [...stack, ...stackMore].map((c, i) => (
            <li class={i >= stack.length ? "chip extra" : "chip"}>
              <span class="ic" aria-hidden="true">
                {c.icon ? (
                  <svg width="15" height="15" viewBox="0 0 24 24">
                    <path fill={chipColor(c)} d={c.icon.path} />
                  </svg>
                ) : (
                  <b style={`color:${chipColor(c)}`}>{c.text}</b>
                )}
              </span>
              <span>{c.label}</span>
            </li>
          ))
        }
        <li>
          <button type="button" class="chip more" aria-expanded="false" data-chips-more>
            +{stackMore.length} more
          </button>
        </li>
      </ul>
    </section>

    <section class="sec" id="reviews" aria-labelledby="reviews-h">
      <div class="sec-head">
        <h2 class="micro" id="reviews-h">07 · Reviews</h2>
        <a class="btn-sm press" href={SITE.linkedinUrl} target="_blank" rel="noopener">
          on linkedin <Icon name="ne" size={14} />
        </a>
      </div>
      {
        reviews.map((r) => (
          <figure class="quote">
            <span class="yr">{r.year}</span>
            <div>
              <blockquote>"{r.quote}"</blockquote>
              <figcaption class="who">
                <b>{r.name}</b> <span>· {r.role}</span>
              </figcaption>
            </div>
          </figure>
        ))
      }
    </section>

    <section class="sec" id="resources" aria-labelledby="resources-h">
      <div class="sec-head"><h2 class="micro" id="resources-h">08 · Resources &amp; gear</h2></div>
      <div class="two three">
        {
          reading.map((group) => (
            <div class="col">
              <h3 class="micro col-label">{group.label}</h3>
              <ul>
                {group.items.map((r) => (
                  <li>
                    <h4>
                      <a href={r.href} target="_blank" rel="noopener">
                        {r.title} <Icon name="ne" size={14} />
                      </a>
                    </h4>
                    <p>{r.desc}</p>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
        <div class="col" id="gear">
          <h3 class="micro col-label">What I use</h3>
          <ul>
            {
              gear.map((g) => (
                <li>
                  <h4>
                    <a href={g.href} target="_blank" rel="noopener">
                      {g.title} <Icon name="ne" size={14} />
                    </a>
                  </h4>
                  <p>{g.desc}</p>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </section>

    <section class="sec" id="github" aria-labelledby="github-h">
      <div class="sec-head">
        <h2 class="micro" id="github-h">09 · GitHub</h2>
        <a class="btn-sm press" href={SITE.githubUrl} target="_blank" rel="noopener">
          @{SITE.githubUser} <Icon name="ne" size={14} />
        </a>
      </div>
      <ContribGraph />
    </section>
  </div>

  <script is:inline>
    // The logo strip can be paused (WCAG 2.2.2); it also stops while a
    // pointer or keyboard focus is on it, and under reduced motion.
    (function () {
      var btn = document.querySelector("[data-marquee-toggle]");
      var strip = document.querySelector("[data-marquee]");
      if (!btn || !strip) return;
      btn.addEventListener("click", function () {
        var paused = strip.classList.toggle("paused");
        btn.setAttribute("aria-pressed", String(paused));
      });
    })();
  
    // The stack opens its remaining chips in place; without JS they all show.
    (function () {
      var btn = document.querySelector("[data-chips-more]");
      var list = document.querySelector("[data-chips]");
      if (!btn || !list) return;
      btn.addEventListener("click", function () {
        list.classList.add("open");
        btn.setAttribute("aria-expanded", "true");
        var first = list.querySelector(".chip.extra");
        if (first) {
          first.setAttribute("tabindex", "-1");
          first.focus();
        }
      });
    })();
  </script>
</Base>
