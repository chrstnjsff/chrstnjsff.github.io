---
import Base from "../layouts/Base.astro";
import SectionLabel from "../components/SectionLabel.astro";
import Portrait from "../components/Portrait.astro";
import Role from "../components/Role.astro";
import Bullet from "../components/Bullet.astro";

const title = "Christian Josef Aquino — Senior DevOps Engineer";
const description =
  "Senior DevOps engineer in Metro Manila with 7+ years building and operating production cloud infrastructure on AWS, GCP, and Azure. Kubernetes, Terraform/OpenTofu, GitOps, and observability.";

const stats = [
  { v: "7+ yrs", l: "experience" },
  { v: "99.95%", l: "uptime" },
  { v: "−40%", l: "mttr" },
  { v: "3.6M+", l: "users served" },
];

const stack = [
  { k: "Cloud", v: ["AWS", "Google Cloud", "Azure"] },
  {
    k: "Containers & Orchestration",
    v: ["Kubernetes — EKS · GKE · AKS", "Docker", "Helm", "Karpenter"],
  },
  { k: "Infrastructure as Code", v: ["Terraform", "OpenTofu", "Pulumi"] },
  {
    k: "CI/CD & GitOps",
    v: ["GitLab CI/CD", "ArgoCD", "Jenkins", "GitHub Actions", "SonarQube"],
  },
  {
    k: "Observability & Reliability",
    v: ["Grafana", "Prometheus", "SLA / SLO", "Incident response", "RCA"],
  },
  { k: "Scripting & Systems", v: ["Python", "Bash", "PowerShell", "Linux"] },
];
---

<Base title={title} description={description}>
  <div class="mx-auto max-w-4xl px-6 sm:px-10 lg:px-14">
    <!-- ============================= HERO ============================= -->
    <section id="top" class="relative pb-4 pt-14 sm:pt-20">
      <div class="grid gap-9 sm:grid-cols-[18rem_1fr] sm:items-start sm:gap-10">
        <Portrait />

        <div>
          <h1
            class="reveal d1 font-pixel text-3xl leading-none tracking-tight sm:text-[2.6rem]"
          >
            Christian Josef Aquino
          </h1>

          <p class="reveal d2 mt-6 max-w-md text-[15px] leading-relaxed text-muted">
            I'm a senior DevOps engineer. I build the cloud infrastructure
            underneath production systems — Kubernetes, Terraform, and the
            pipelines that ship to them.
          </p>

          <p class="reveal d3 mt-4 max-w-md text-[15px] leading-relaxed text-muted">
            Right now I keep a mission-critical platform{" "}
            <span class="font-serif italic text-ink">quietly, relentlessly boring</span>{" "}
            across AWS, GCP, and Azure. Good automation, real observability, and
            incident practice do most of that work.
          </p>

          <div
            class="reveal d4 mt-7 flex flex-wrap items-center gap-x-3 gap-y-1.5 font-mono text-[12px] text-muted"
          >
            <a
              href="https://github.com/chrstnjsff"
              target="_blank"
              rel="me noopener"
              class="hover:text-ink">github ↗</a
            >
            <a href="mailto:chrstnjsff@gmail.com" class="hover:text-ink">email ↗</a>
          </div>
        </div>
      </div>
    </section>

    <!-- ============================= STATS ============================= -->
    <section
      class="reveal mt-10 grid grid-cols-2 divide-x divide-y divide-line/12 border-t border-line/12 sm:grid-cols-4 sm:divide-y-0"
      aria-label="Key figures"
    >
      {
        stats.map((s, i) => (
          <div class={`py-6 pr-5 sm:px-5 ${i === 0 ? "sm:pl-0" : ""}`}>
            <div class="tnum font-pixel text-lg leading-none">{s.v}</div>
            <div class="mt-2 font-mono text-[11px] uppercase tracking-wider text-muted">
              {s.l}
            </div>
          </div>
        ))
      }
    </section>

    <!-- ============================= ABOUT ============================= -->
    <section id="about" class="relative scroll-mt-20 py-14">
      <div
        aria-hidden="true"
        class="halftone mask-circle pointer-events-none absolute -left-10 bottom-6 hidden h-32 w-32 opacity-20 lg:block"
      >
      </div>

      <SectionLabel n="01" name="about" />

      <div class="reveal d1 max-w-xl space-y-4 text-[15px] leading-relaxed text-muted">
        <p>
          Seven-plus years designing, implementing, and operating production
          cloud infrastructure and networked systems across AWS, GCP, and Azure.
          My work sits where infrastructure as code, Kubernetes, and delivery
          pipelines meet — and where they break.
        </p>
        <p>
          Day to day that means multi-cluster Kubernetes administration across
          EKS, GKE, and AKS; reusable Terraform and OpenTofu modules that keep
          staging and production honest; GitLab CI/CD and ArgoCD pipelines; and
          Prometheus and Grafana instrumentation that turns{" "}
          <span class="font-serif italic text-ink">something feels slow</span>{" "}
          into a named root cause.
        </p>
        <p>
          I lead P1 and P2 incident response, run root cause analysis, plan
          capacity, and close security gaps in infrastructure repositories and
          pipelines.
        </p>
      </div>

      <p
        class="reveal d2 mt-8 font-mono text-[11px] uppercase tracking-wider text-muted"
      >
        BS Information Technology · Jose Rizal University · 2017
      </p>
    </section>

    <!-- ============================= EXPERIENCE ============================= -->
    <section id="experience" class="relative scroll-mt-20 py-14">
      <SectionLabel n="02" name="experience" />

      <div>
        <Role
          company="Iron Mountain Philippines"
          role="Senior DevOps Engineer"
          period="Oct 2025 — Present"
          location="Taguig City"
          current={true}
        >
          <Bullet metric="35% faster provisioning">
            Design and maintain multi-cloud infrastructure across AWS, GCP, and
            Azure with custom OpenTofu modules, holding parity between staging
            and production —
          </Bullet>
          <Bullet metric="99.95% uptime">
            Administer and upgrade multi-cluster Kubernetes environments (EKS,
            GKE, AKS): zero-downtime version upgrades, Karpenter node
            autoscaling, and capacity planning for the mission-critical ICM
            application —
          </Bullet>
          <Bullet metric="MTTR −40%">
            Lead P1/P2 incident response and root cause analysis, backed by
            Grafana dashboards, alert rules, and SLA/SLO monitoring —
          </Bullet>
          <Bullet>
            Build GitLab CI/CD pipelines for infrastructure and application
            delivery, and remediate exposed secrets across infrastructure
            repositories and pipelines.
          </Bullet>
        </Role>

        <Role
          company="One Team Anywhere"
          role="Cloud & DevOps Engineer"
          period="May 2024 — Oct 2025"
          location="Mandaluyong City"
          delay="d1"
        >
          <Bullet metric="40% faster deploys · 99.99% availability">
            Designed AWS and GCP infrastructure with Terraform, Pulumi, and
            OpenTofu, and ran EKS/GKE clusters with autoscaling and ArgoCD
            GitOps delivery —
          </Bullet>
          <Bullet metric="99.9% SLA">
            Architected a Prometheus and Grafana observability framework with
            alerting and on-call escalation workflows —
          </Bullet>
          <Bullet metric="+30% reliability">
            Automated build, test, and release promotion, and supported
            production operations across infrastructure, networking, and
            workloads —
          </Bullet>
        </Role>

        <Role
          company="Stratpoint Global Outsourcing"
          role="Cloud Engineer III"
          period="Mar 2022 — May 2024"
          location="Mandaluyong City"
          delay="d1"
        >
          <Bullet metric="onboarding −60%">
            Helped design and build an internal developer platform for
            self-service AWS resource provisioning —
          </Bullet>
          <Bullet metric="provisioning −65%">
            Built reusable Terraform modules for 10+ AWS services (EKS, RDS, S3,
            IAM), standardising deployments across environments —
          </Bullet>
          <Bullet metric="3.6M+ users">
            Served as technical lead for four application engineers across
            frontend, backend, and infrastructure for a telco platform —
          </Bullet>
        </Role>

        <Role
          company="DXC Technology"
          role="Service Information Developer III"
          period="Oct 2020 — Mar 2022"
          location="Taguig City"
          delay="d1"
        >
          <Bullet metric="99.5% SLA">
            Single point of contact for AWS infrastructure across three luxury
            retail clients operating 1,000+ stores, covering on-call rotations,
            monthly patching, and incident handling —
          </Bullet>
          <Bullet>
            Developed Terraform modules for AWS provisioning, authored
            operational runbooks, and tuned database queries and indexing for
            the EPOS retail platform.
          </Bullet>
        </Role>

        <Role
          company="Bosch Service Solutions"
          role="Service Desk Engineer"
          period="Dec 2018 — Oct 2020"
          location="Taguig City"
          delay="d1"
        >
          <Bullet metric="30 min → 2 min">
            Wrote PowerShell automation for software installation and
            configuration, cutting install time —
          </Bullet>
          <Bullet metric="escalations −15%">
            Handled ~60 tickets daily and designed troubleshooting protocols
            that let the team absorb 40+ additional daily tickets —
          </Bullet>
        </Role>
      </div>
    </section>

    <!-- ============================= STACK ============================= -->
    <section id="stack" class="relative scroll-mt-20 py-14">
      <div
        aria-hidden="true"
        class="halftone mask-circle pointer-events-none absolute -right-12 top-10 hidden h-36 w-36 opacity-20 lg:block"
      >
      </div>

      <SectionLabel n="03" name="stack" />

      <dl class="divide-y divide-line/12 border-y border-line/12">
        {
          stack.map((group, i) => (
            <div
              class={`reveal ${i < 5 ? `d${i + 1}` : "d5"} py-4 sm:grid sm:grid-cols-[13rem_1fr] sm:gap-6`}
            >
              <dt class="font-mono text-[11px] uppercase tracking-wider text-muted">
                {group.k}
              </dt>
              <dd class="mt-1.5 text-[14.5px] leading-relaxed text-ink sm:mt-0">
                {group.v.map((item, j) => (
                  <>
                    {j > 0 && (
                      <span class="mx-2 text-muted opacity-40" aria-hidden="true">
                        ·
                      </span>
                    )}
                    <span>{item}</span>
                  </>
                ))}
              </dd>
            </div>
          ))
        }
      </dl>
    </section>

    <!-- ============================= CONTACT ============================= -->
    <section id="contact" class="relative scroll-mt-20 py-14">
      <SectionLabel n="04" name="contact" />

      <h3 class="reveal d1 font-pixel text-xl leading-none">say hello</h3>

      <p class="reveal d2 mt-5 max-w-md text-[15px] leading-relaxed text-muted">
        Open to conversations about platform engineering, reliability work, and
        anything involving Kubernetes at an awkward hour.
      </p>

      <ul class="reveal d3 mt-7 space-y-3">
        <li>
          <a
            href="mailto:chrstnjsff@gmail.com"
            class="link-ul font-mono text-[14px] text-ink"
          >
            chrstnjsff@gmail.com
          </a>
        </li>
        <li>
          <a
            href="https://github.com/chrstnjsff"
            target="_blank"
            rel="me noopener"
            class="link-ul font-mono text-[14px] text-ink"
          >
            github.com/chrstnjsff
          </a>
        </li>
      </ul>
    </section>

    <!-- ============================= FOOTER ============================= -->
    <footer class="border-t border-line/12 py-8">
      <div
        class="flex flex-col gap-2 font-mono text-[11px] text-muted sm:flex-row sm:items-center sm:justify-between"
      >
        <p>© 2026 Christian Josef Aquino</p>
        <p>Built with Astro · deployed via GitHub Actions</p>
      </div>
    </footer>
  </div>
</Base>
