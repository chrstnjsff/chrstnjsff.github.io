---
import Base from "../layouts/Base.astro";
import SectionLabel from "../components/SectionLabel.astro";
import Portrait from "../components/Portrait.astro";
import Role from "../components/Role.astro";
import Bullet from "../components/Bullet.astro";
import ContribGraph from "../components/ContribGraph.astro";
import FlappyGame from "../components/FlappyGame.astro";

const title = "Christian Josef Aquino — Senior DevOps Engineer";
const description =
  "Senior DevOps engineer in Metro Manila with 7+ years building and operating production cloud infrastructure on AWS, GCP, and Azure. Kubernetes, Terraform/OpenTofu, GitOps, and observability.";

const stats = [
  { v: "7+", l: "years of experience" },
  { v: "99.95%", l: "platform uptime sustained" },
  { v: "40%", l: "faster incident recovery" },
  { v: "3.6M+", l: "users on platforms I run" },
];

const stack = [
  { k: "Cloud", v: ["AWS", "Google Cloud", "Azure"] },
  {
    k: "Containers & Orchestration",
    v: ["Kubernetes — EKS · GKE · AKS", "Docker", "Helm", "Karpenter"],
  },
  { k: "Infrastructure as Code", v: ["Terraform", "OpenTofu", "Pulumi"] },
  {
    k: "CI/CD & GitOps",
    v: ["GitLab CI/CD", "ArgoCD", "Jenkins", "GitHub Actions", "SonarQube"],
  },
  {
    k: "Observability & Reliability",
    v: ["Grafana", "Prometheus", "SLA / SLO", "Incident response", "RCA"],
  },
  { k: "Scripting & Systems", v: ["Python", "Bash", "PowerShell", "Linux"] },
];

const certs = [
  {
    issuer: "HashiCorp",
    title: "HashiCorp Certified: Terraform Associate",
    href: "https://developer.hashicorp.com/certifications/infrastructure-automation",
  },
  {
    issuer: "Amazon Web Services",
    title: "AWS Certified Cloud Practitioner",
    href: "https://aws.amazon.com/certification/certified-cloud-practitioner/",
  },
];

const resources = [
  {
    group: "DevOps & Platform",
    items: [
      {
        title: "Google SRE Book",
        desc: "The reliability engineering canon, free to read",
        href: "https://sre.google/books/",
        domain: "sre.google",
      },
      {
        title: "Kubernetes the Hard Way",
        desc: "Kubernetes from first principles, no scripts",
        href: "https://github.com/kelseyhightower/kubernetes-the-hard-way",
        domain: "github.com",
      },
      {
        title: "CNCF Landscape",
        desc: "The map of the cloud-native ecosystem",
        href: "https://landscape.cncf.io/",
        domain: "landscape.cncf.io",
      },
      {
        title: "DevOps Roadmap",
        desc: "The learning path, kept current",
        href: "https://roadmap.sh/devops",
        domain: "roadmap.sh",
      },
      {
        title: "Terraform Registry",
        desc: "Providers and modules worth stealing from",
        href: "https://registry.terraform.io/",
        domain: "registry.terraform.io",
      },
    ],
  },
  {
    group: "LLMs & AI Engineering",
    items: [
      {
        title: "Anthropic Docs",
        desc: "Building with Claude — API, agents, MCP",
        href: "https://docs.anthropic.com/",
        domain: "docs.anthropic.com",
      },
      {
        title: "Anthropic Cookbook",
        desc: "Working patterns for LLM applications",
        href: "https://github.com/anthropics/anthropic-cookbook",
        domain: "github.com",
      },
      {
        title: "Simon Willison's Weblog",
        desc: "The running commentary on the LLM era",
        href: "https://simonwillison.net/",
        domain: "simonwillison.net",
      },
      {
        title: "Prompt Engineering Guide",
        desc: "Techniques, papers, and model quirks",
        href: "https://www.promptingguide.ai/",
        domain: "promptingguide.ai",
      },
      {
        title: "Hugging Face",
        desc: "Models, datasets, and spaces",
        href: "https://huggingface.co/",
        domain: "huggingface.co",
      },
      {
        title: "Ollama",
        desc: "Run open models on your own machine",
        href: "https://ollama.com/",
        domain: "ollama.com",
      },
    ],
  },
];

const gear = [
  {
    name: "MacBook Pro — M5 Pro",
    note: "daily driver",
    href: "https://www.apple.com/macbook-pro/",
    domain: "apple.com",
  },
  {
    name: "NuPhy keyboard",
    note: "low-profile mechanical",
    href: "https://nuphy.com/",
    domain: "nuphy.com",
  },
  {
    name: "Shokz bone-conduction headphones",
    note: "on-call, ears open",
    href: "https://shokz.com/",
    domain: "shokz.com",
  },
  {
    name: "Apple Watch Series 11",
    note: "pages reach me anywhere",
    href: "https://www.apple.com/watch/",
    domain: "apple.com",
  },
];
---

<Base title={title} description={description}>
  <div class="mx-auto max-w-2xl px-6 pb-16">
    <!-- ============================= HERO ============================= -->
    <section id="top" class="relative pb-4 pt-14 sm:pt-20">
      <div
        class="flex flex-col-reverse gap-8 sm:flex-row sm:items-start sm:justify-between sm:gap-10"
      >
        <div class="max-w-md">
          <h1
            class="reveal d1 text-[2.1rem] font-semibold leading-[1.06] tracking-tight sm:text-[2.6rem]"
          >
            Christian Josef Aquino
          </h1>

          <p class="reveal d2 mt-4 font-mono text-[13px] text-muted">
            senior devops engineer · metro manila{" "}
            <span class="cursor-blink" aria-hidden="true">▮</span>
          </p>

          <p class="reveal d3 mt-6 text-[15px] leading-relaxed text-muted">
            I'm a senior DevOps engineer. I build the cloud infrastructure
            underneath production systems — Kubernetes, Terraform, and the
            pipelines that ship to them.
          </p>

          <p class="reveal d3 mt-4 text-[15px] leading-relaxed text-muted">
            Right now I keep a mission-critical platform{" "}
            <span class="font-serif italic text-ink">quietly, relentlessly boring</span>{" "}
            across AWS, GCP, and Azure. Good automation, real observability, and
            incident practice do most of that work.
          </p>

          <div
            class="reveal d4 mt-7 flex flex-wrap items-center gap-x-4 gap-y-1.5 font-mono text-[12px] text-muted"
          >
            <a
              href="https://github.com/chrstnjsff"
              target="_blank"
              rel="me noopener"
              class="hover:text-ink">github ↗</a
            >
            <a href="mailto:chrstnjsff@gmail.com" class="hover:text-ink">email ↗</a>
          </div>
        </div>

        <Portrait class="w-28 shrink-0 sm:w-40" />
      </div>

      <!-- career highlights -->
      <div
        class="reveal d5 mt-12 grid grid-cols-2 gap-x-6 gap-y-6 border-y border-line/12 py-6 sm:grid-cols-4"
        role="group"
        aria-label="Career highlights"
      >
        {
          stats.map((s) => (
            <div>
              <div class="text-xl font-semibold tracking-tight text-ink">{s.v}</div>
              <div class="mt-1 text-[12px] leading-snug text-muted">{s.l}</div>
            </div>
          ))
        }
      </div>
    </section>

    <!-- ============================= ABOUT ============================= -->
    <section id="about" class="relative scroll-mt-16 py-14">
      <SectionLabel name="about" />

      <div class="reveal d1 space-y-4 text-[15px] leading-relaxed text-muted">
        <p>
          Seven-plus years designing, implementing, and operating production
          cloud infrastructure and networked systems across AWS, GCP, and Azure.
          My work sits where infrastructure as code, Kubernetes, and delivery
          pipelines meet — and where they break.
        </p>
        <p>
          Day to day that means multi-cluster Kubernetes administration across
          EKS, GKE, and AKS; reusable Terraform and OpenTofu modules that keep
          staging and production honest; GitLab CI/CD and ArgoCD pipelines; and
          Prometheus and Grafana instrumentation that turns{" "}
          <span class="font-serif italic text-ink">something feels slow</span>{" "}
          into a named root cause.
        </p>
        <p>
          I lead P1 and P2 incident response, run root cause analysis, plan
          capacity, and close security gaps in infrastructure repositories and
          pipelines.
        </p>
      </div>

      <p
        class="reveal d2 mt-8 font-mono text-[11px] uppercase tracking-wider text-muted"
      >
        BS Information Technology · Jose Rizal University · 2017
      </p>
    </section>

    <!-- ============================= EXPERIENCE ============================= -->
    <section id="experience" class="relative scroll-mt-16 py-14">
      <SectionLabel name="experience" />

      <div>
        <Role
          company="Iron Mountain Philippines"
          role="Senior DevOps Engineer"
          period="Oct 2025 — Present"
          location="Taguig City"
          current={true}
        >
          <Bullet metric="35% faster provisioning">
            Design and maintain multi-cloud infrastructure across AWS, GCP, and
            Azure with custom OpenTofu modules, holding parity between staging
            and production —
          </Bullet>
          <Bullet metric="99.95% uptime">
            Administer and upgrade multi-cluster Kubernetes environments (EKS,
            GKE, AKS): zero-downtime version upgrades, Karpenter node
            autoscaling, and capacity planning for the mission-critical ICM
            application —
          </Bullet>
          <Bullet metric="MTTR −40%">
            Lead P1/P2 incident response and root cause analysis, backed by
            Grafana dashboards, alert rules, and SLA/SLO monitoring —
          </Bullet>
          <Bullet>
            Build GitLab CI/CD pipelines for infrastructure and application
            delivery, and remediate exposed secrets across infrastructure
            repositories and pipelines.
          </Bullet>
        </Role>

        <Role
          company="One Team Anywhere"
          role="Cloud & DevOps Engineer"
          period="May 2024 — Oct 2025"
          location="Mandaluyong City"
          delay="d1"
        >
          <Bullet metric="40% faster deploys · 99.99% availability">
            Designed AWS and GCP infrastructure with Terraform, Pulumi, and
            OpenTofu, and ran EKS/GKE clusters with autoscaling and ArgoCD
            GitOps delivery —
          </Bullet>
          <Bullet metric="99.9% SLA">
            Architected a Prometheus and Grafana observability framework with
            alerting and on-call escalation workflows —
          </Bullet>
          <Bullet metric="+30% reliability">
            Automated build, test, and release promotion, and supported
            production operations across infrastructure, networking, and
            workloads —
          </Bullet>
        </Role>

        <Role
          company="Stratpoint Global Outsourcing"
          role="Cloud Engineer III"
          period="Mar 2022 — May 2024"
          location="Mandaluyong City"
          delay="d1"
        >
          <Bullet metric="onboarding −60%">
            Helped design and build an internal developer platform for
            self-service AWS resource provisioning —
          </Bullet>
          <Bullet metric="provisioning −65%">
            Built reusable Terraform modules for 10+ AWS services (EKS, RDS, S3,
            IAM), standardising deployments across environments —
          </Bullet>
          <Bullet metric="3.6M+ users">
            Served as technical lead for four application engineers across
            frontend, backend, and infrastructure for a telco platform —
          </Bullet>
        </Role>

        <Role
          company="DXC Technology"
          role="Service Information Developer III"
          period="Oct 2020 — Mar 2022"
          location="Taguig City"
          delay="d1"
        >
          <Bullet metric="99.5% SLA">
            Single point of contact for AWS infrastructure across three luxury
            retail clients operating 1,000+ stores, covering on-call rotations,
            monthly patching, and incident handling —
          </Bullet>
          <Bullet>
            Developed Terraform modules for AWS provisioning, authored
            operational runbooks, and tuned database queries and indexing for
            the EPOS retail platform.
          </Bullet>
        </Role>

        <Role
          company="Bosch Service Solutions"
          role="Service Desk Engineer"
          period="Dec 2018 — Oct 2020"
          location="Taguig City"
          delay="d1"
        >
          <Bullet metric="30 min → 2 min">
            Wrote PowerShell automation for software installation and
            configuration, cutting install time —
          </Bullet>
          <Bullet metric="escalations −15%">
            Handled ~60 tickets daily and designed troubleshooting protocols
            that let the team absorb 40+ additional daily tickets —
          </Bullet>
        </Role>
      </div>
    </section>

    <!-- ============================= STACK ============================= -->
    <section id="stack" class="relative scroll-mt-16 py-14">
      <SectionLabel name="stack" />

      <dl class="divide-y divide-line/12 border-y border-line/12">
        {
          stack.map((group, i) => (
            <div
              class={`reveal ${i < 5 ? `d${i + 1}` : "d5"} py-4 sm:grid sm:grid-cols-[13rem_1fr] sm:gap-6`}
            >
              <dt class="font-mono text-[11px] uppercase tracking-wider text-muted">
                {group.k}
              </dt>
              <dd class="mt-1.5 text-[14.5px] leading-relaxed text-ink sm:mt-0">
                {group.v.map((item, j) => (
                  <>
                    {j > 0 && (
                      <span class="mx-2 text-muted opacity-40" aria-hidden="true">
                        ·
                      </span>
                    )}
                    <span>{item}</span>
                  </>
                ))}
              </dd>
            </div>
          ))
        }
      </dl>
    </section>

    <!-- ============================= CERTIFICATIONS ============================= -->
    <section id="certifications" class="relative scroll-mt-16 py-14">
      <SectionLabel name="certifications" />

      <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
        {
          certs.map((c, i) => (
            <a
              href={c.href}
              target="_blank"
              rel="noopener"
              class={`reveal ${i === 1 ? "d1" : ""} group card-tick card-lift p-5`}
            >
              <p class="font-mono text-[10px] uppercase tracking-wider text-muted">
                {c.issuer}
              </p>
              <h3 class="mt-3 text-[13px] font-semibold leading-snug text-ink">
                {c.title}
              </h3>
              <p class="mt-4 font-mono text-[11px] text-muted group-hover:text-ink">
                about this cert ↗
              </p>
            </a>
          ))
        }
      </div>
    </section>

    <!-- ============================= RECOMMENDATIONS ============================= -->
    <section id="recommendations" class="relative scroll-mt-16 py-14">
      <SectionLabel name="recommendations" />

      <figure class="reveal d1 max-w-xl border-l-2 border-line/20 pl-6">
        <blockquote class="font-serif text-[16px] italic leading-relaxed text-ink">
          “Cj is a fast learner and easy to work with. Even I am a senior to
          him, he also helped me with difficulties at work. He is very
          cooperative and hardworking.”
        </blockquote>
        <figcaption class="mt-4">
          <p class="text-[13px] font-medium text-ink">Danica Capistrano</p>
          <p class="mt-1 font-mono text-[11px] uppercase tracking-wider text-muted">
            Support Analyst 2 · Koerber Supply Chain Software
          </p>
          <p class="mt-1 font-mono text-[11px] text-muted">
            senior colleague · May 2021 · via LinkedIn
          </p>
        </figcaption>
      </figure>
    </section>

    <!-- ============================= RESOURCES ============================= -->
    <section id="resources" class="relative scroll-mt-16 py-14">
      <SectionLabel name="resources" />

      <div class="space-y-8">
        {
          resources.map((section) => (
            <div>
              <h3 class="reveal font-mono text-[11px] uppercase tracking-wider text-muted">
                {section.group}
              </h3>
              <div class="mt-3 grid grid-cols-1 gap-2.5 sm:grid-cols-2">
                {section.items.map((r, i) => (
                  <a
                    href={r.href}
                    target="_blank"
                    rel="noopener"
                    class={`reveal ${i < 4 ? `d${i + 1}` : "d4"} group card-tick card-lift px-4 py-3.5`}
                  >
                    <div class="flex items-baseline justify-between gap-3">
                      <h4 class="text-[13px] font-medium text-ink">{r.title}</h4>
                      <span
                        class="shrink-0 font-mono text-[11px] text-muted transition-transform group-hover:-translate-y-0.5 group-hover:translate-x-0.5 group-hover:text-ink"
                        aria-hidden="true"
                      >
                        ↗
                      </span>
                    </div>
                    <p class="mt-1 text-[12.5px] leading-relaxed text-muted">{r.desc}</p>
                    <p class="mt-2 font-mono text-[10px] tracking-wide text-muted opacity-70">
                      {r.domain}
                    </p>
                  </a>
                ))}
              </div>
            </div>
          ))
        }
      </div>
    </section>

    <!-- ============================= GEAR ============================= -->
    <section id="gear" class="relative scroll-mt-16 py-14">
      <SectionLabel name="gear" />

      <div class="grid grid-cols-1 gap-2.5 sm:grid-cols-2">
        {
          gear.map((g, i) => (
            <a
              href={g.href}
              target="_blank"
              rel="noopener"
              class={`reveal ${i < 4 ? `d${i + 1}` : ""} group card-tick card-lift flex items-baseline justify-between gap-4 px-4 py-3.5`}
            >
              <div>
                <h3 class="text-[13px] font-medium text-ink">{g.name}</h3>
                <p class="mt-1 font-mono text-[11px] text-muted">{g.note}</p>
              </div>
              <span
                class="shrink-0 font-mono text-[11px] text-muted transition-transform group-hover:-translate-y-0.5 group-hover:translate-x-0.5 group-hover:text-ink"
                aria-hidden="true"
              >
                ↗
              </span>
            </a>
          ))
        }
      </div>
    </section>

    <!-- ============================= GITHUB ============================= -->
    <section id="github" class="relative scroll-mt-16 py-14">
      <SectionLabel
        name="github"
        actionLabel="@chrstnjsff"
        actionHref="https://github.com/chrstnjsff"
        external
      />

      <ContribGraph />
    </section>

    <!-- ============================= PLAY ============================= -->
    <section id="play" class="relative scroll-mt-16 py-14">
      <SectionLabel name="play" />

      <FlappyGame />
    </section>

  </div>
</Base>
