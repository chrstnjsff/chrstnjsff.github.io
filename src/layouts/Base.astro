---
import "@fontsource-variable/geist";
import "@fontsource-variable/geist-mono";
import "@fontsource-variable/source-serif-4";
import "../styles/global.css";
import Sidebar from "../components/Sidebar.astro";
import Logo from "../components/Logo.astro";

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL("/og.png", Astro.site).href;

const person = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Christian Josef Aquino",
  jobTitle: "Senior DevOps Engineer",
  url: "https://chrstnjsff.github.io/",
  email: "mailto:chrstnjsff@gmail.com",
  address: {
    "@type": "PostalAddress",
    addressLocality: "Metro Manila",
    addressCountry: "PH",
  },
  sameAs: ["https://github.com/chrstnjsff"],
  knowsAbout: [
    "Kubernetes",
    "Terraform",
    "OpenTofu",
    "Amazon Web Services",
    "Google Cloud Platform",
    "Microsoft Azure",
    "Site Reliability Engineering",
    "CI/CD",
    "GitOps",
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="generator" content={Astro.generator} />

    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0c0c0f" media="(prefers-color-scheme: dark)" />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link
      rel="preload"
      href="/fonts/GeistPixel-Square.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <script is:inline>
      // Resolve the theme before first paint — no flash of the wrong theme.
      (function () {
        try {
          var pref = localStorage.getItem("theme") || "system";
          var dark =
            pref === "dark" ||
            (pref === "system" &&
              window.matchMedia("(prefers-color-scheme: dark)").matches);
          document.documentElement.classList.toggle("dark", dark);
        } catch (e) {}
      })();
    </script>

    <script type="application/ld+json" set:html={JSON.stringify(person)} />
  </head>

  <body class="font-sans antialiased">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[80] focus:bg-ink focus:px-4 focus:py-2 focus:font-mono focus:text-xs focus:text-bg"
    >
      Skip to content
    </a>

    <!-- background dot field -->
    <div aria-hidden="true" class="pointer-events-none fixed inset-0 z-0">
      <div class="halftone absolute inset-0 opacity-[0.055]"></div>
    </div>

    <!-- scroll progress hairline -->
    <div
      id="scroll-progress"
      aria-hidden="true"
      class="fixed left-0 top-0 z-[70] h-px w-full bg-accent"
    >
    </div>

    <!-- fixed rail (lg+) -->
    <nav
      class="fixed inset-y-0 left-0 z-50 hidden w-56 flex-col border-r border-line/12 bg-bg px-7 py-8 lg:flex"
      aria-label="Primary"
    >
      <Sidebar />
    </nav>

    <!-- mobile bar -->
    <div
      class="sticky top-0 z-50 flex h-14 items-center justify-between border-b border-line/12 bg-bg/85 px-5 backdrop-blur-md lg:hidden"
    >
      <a href="#top" class="leading-none" aria-label="Christian Josef Aquino — back to top">
        <Logo size={24} />
      </a>
      <button
        type="button"
        id="mobile-nav-open"
        class="grid h-8 w-8 place-items-center text-muted hover:text-ink"
        aria-label="Open menu"
        aria-controls="mobileNav"
        aria-expanded="false"
      >
        <svg viewBox="0 0 24 24" fill="none" class="h-4 w-4" aria-hidden="true">
          <path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"></path>
        </svg>
      </button>
    </div>

    <!-- mobile overlay -->
    <div
      id="mobileNav"
      class="fixed inset-0 z-[60] hidden flex-col bg-bg px-7 py-8 lg:hidden"
    >
      <button
        type="button"
        id="mobile-nav-close"
        class="absolute right-4 top-4 grid h-8 w-8 place-items-center text-muted hover:text-ink"
        aria-label="Close menu"
      >
        <svg viewBox="0 0 24 24" fill="none" class="h-4 w-4" aria-hidden="true">
          <path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"></path>
        </svg>
      </button>
      <Sidebar mobile={true} />
    </div>

    <main id="main" class="relative z-10 lg:pl-56">
      <slot />
    </main>

    <script is:inline>
      // ---- theme: system | light | dark -------------------------------
      (function () {
        var media = window.matchMedia("(prefers-color-scheme: dark)");

        function read() {
          try {
            return localStorage.getItem("theme") || "system";
          } catch (e) {
            return "system";
          }
        }

        function apply(pref) {
          var dark = pref === "dark" || (pref === "system" && media.matches);
          document.documentElement.classList.toggle("dark", dark);
          document.querySelectorAll("[data-theme-opt]").forEach(function (b) {
            b.setAttribute("aria-pressed", String(b.dataset.themeOpt === pref));
          });
        }

        window.setTheme = function (pref) {
          try {
            localStorage.setItem("theme", pref);
          } catch (e) {}
          var reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
          if (document.startViewTransition && !reduce) {
            document.startViewTransition(function () {
              apply(pref);
            });
          } else if (!reduce) {
            var root = document.documentElement;
            root.classList.add("theme-fade");
            apply(pref);
            setTimeout(function () {
              root.classList.remove("theme-fade");
            }, 400);
          } else {
            apply(pref);
          }
        };

        document.querySelectorAll("[data-theme-opt]").forEach(function (b) {
          b.addEventListener("click", function () {
            window.setTheme(b.dataset.themeOpt);
          });
        });

        // follow the OS while the preference is "system"
        media.addEventListener("change", function () {
          if (read() === "system") apply("system");
        });

        apply(read());
      })();

      // ---- scroll progress hairline -----------------------------------
      (function () {
        var bar = document.getElementById("scroll-progress");
        if (!bar) return;
        var ticking = false;

        function update() {
          ticking = false;
          var doc = document.documentElement;
          var max = doc.scrollHeight - window.innerHeight;
          var p = max > 0 ? window.scrollY / max : 0;
          bar.style.transform = "scaleX(" + Math.min(1, Math.max(0, p)) + ")";
        }

        window.addEventListener(
          "scroll",
          function () {
            if (!ticking) {
              ticking = true;
              requestAnimationFrame(update);
            }
          },
          { passive: true }
        );
        window.addEventListener("resize", update, { passive: true });
        update();
      })();

      // ---- mobile nav --------------------------------------------------
      (function () {
        var panel = document.getElementById("mobileNav");
        var openBtn = document.getElementById("mobile-nav-open");
        var closeBtn = document.getElementById("mobile-nav-close");
        if (!panel || !openBtn || !closeBtn) return;

        function open() {
          panel.classList.remove("hidden");
          panel.classList.add("flex");
          openBtn.setAttribute("aria-expanded", "true");
          document.body.style.overflow = "hidden";
          closeBtn.focus();
        }

        function close() {
          panel.classList.add("hidden");
          panel.classList.remove("flex");
          openBtn.setAttribute("aria-expanded", "false");
          document.body.style.overflow = "";
          openBtn.focus();
        }

        openBtn.addEventListener("click", open);
        closeBtn.addEventListener("click", close);
        panel.querySelectorAll("a").forEach(function (a) {
          a.addEventListener("click", close);
        });
        document.addEventListener("keydown", function (e) {
          if (e.key === "Escape" && !panel.classList.contains("hidden")) close();
        });
      })();

      // ---- reveal on scroll --------------------------------------------
      (function () {
        var items = document.querySelectorAll(".reveal");
        if (!items.length) return;

        if (
          window.matchMedia("(prefers-reduced-motion: reduce)").matches ||
          !("IntersectionObserver" in window)
        ) {
          items.forEach(function (el) {
            el.classList.add("in");
          });
          return;
        }

        var io = new IntersectionObserver(
          function (entries) {
            entries.forEach(function (entry) {
              if (entry.isIntersecting) {
                entry.target.classList.add("in");
                io.unobserve(entry.target);
              }
            });
          },
          { rootMargin: "0px 0px -8% 0px", threshold: 0.05 }
        );

        items.forEach(function (el) {
          io.observe(el);
        });
      })();

      // ---- top-bar scrollspy ------------------------------------------
      (function () {
        var links = document.querySelectorAll("[data-nav-link]");
        if (!links.length || !("IntersectionObserver" in window)) return;

        var map = {};
        links.forEach(function (a) {
          var id = (a.getAttribute("href") || "").slice(1);
          if (id) (map[id] = map[id] || []).push(a);
        });

        var current = null;
        function activate(id) {
          if (id === current) return;
          current = id;
          links.forEach(function (a) {
            a.removeAttribute("aria-current");
          });
          (map[id] || []).forEach(function (a) {
            a.setAttribute("aria-current", "true");
          });
        }

        var io = new IntersectionObserver(
          function (entries) {
            entries.forEach(function (entry) {
              if (entry.isIntersecting) activate(entry.target.id);
            });
          },
          { rootMargin: "-35% 0px -55% 0px", threshold: 0 }
        );

        Object.keys(map).forEach(function (id) {
          var el = document.getElementById(id);
          if (el) io.observe(el);
        });
      })();
    </script>
  </body>
</html>
