---
import "@fontsource-variable/geist";
import "@fontsource-variable/geist-mono";
import "@fontsource-variable/space-grotesk";
import "../styles/global.css";
import Sidebar from "../components/Sidebar.astro";
import Icon from "../components/Icon.astro";
import Logo from "../components/Logo.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { SITE, type NavItem } from "../config/site";

interface Props {
  title: string;
  description: string;
  /** Root-relative share image; defaults to the site-wide card. */
  ogImage?: string;
  ogType?: "website" | "article" | "profile";
  /** Keep utility pages (e.g. the form thank-you page) out of search. */
  noindex?: boolean;
  /** Structured data blocks, each emitted as its own JSON-LD script. */
  jsonLd?: object[];
  /** In-page links for the sidebar: a guide's steps. */
  outline?: { title: string; items: NavItem[] };
}

const {
  title,
  description,
  ogImage = "/og.png",
  ogType = "website",
  noindex = false,
  jsonLd = [],
  outline,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImageUrl = new URL(ogImage, Astro.site).href;
const isHome = Astro.url.pathname === "/";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="generator" content={Astro.generator} />

    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#ffffff" />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <script is:inline>
      // Resolve the theme before first paint, so there is no flash of the wrong theme.
      // Light is the default; only an explicit "dark" choice turns dark mode on.
      // The js class lets CSS hide scroll-reveal content only when JS will show it.
      (function () {
        document.documentElement.classList.add("js");
        try {
          if (localStorage.getItem("theme") === "dark") {
            document.documentElement.classList.add("dark");
            document.querySelector('meta[name="theme-color"]').content = "#24283b";
          }
        } catch (e) {}
      })();
    </script>

    {jsonLd.map((block) => <script type="application/ld+json" set:html={JSON.stringify(block)} />)}
  </head>

  <body>
    <a href="#main" class="skip">Skip to content</a>

    <!-- desktop rail (lg+) -->
    <aside class="side" aria-label="Site" data-inert-when-menu>
      <a
        class="side-logo"
        href={isHome ? "#top" : "/"}
        aria-label={isHome ? `${SITE.name}, back to top` : `${SITE.name}, home`}
      >
        <Logo />
      </a>
      <Sidebar outline={outline} />
    </aside>

    <!-- phone and tablet: top bar, and the menu sheet it opens -->
    <header class="topbar">
      <a
        data-topbar-logo
        href={isHome ? "#top" : "/"}
        aria-label={isHome ? `${SITE.name}, back to top` : `${SITE.name}, home`}
      >
        <Logo size={26} />
      </a>
      <button
        type="button"
        class="icon-btn"
        id="menuBtn"
        aria-expanded="false"
        aria-controls="sheet"
        aria-label="Open menu"
      >
        <Icon name="menu" size={20} class="i-menu" />
        <Icon name="x" size={20} class="i-x" />
      </button>
    </header>
    <div class="sheet" id="sheet" hidden>
      <Sidebar outline={outline} />
    </div>

    <div class="page" data-inert-when-menu>
      <main id="main" class="page-body">
        <slot />
      </main>
      <SiteFooter />
    </div>

    <script is:inline>
      // ---- theme: light (default) | dark --------------------------------
      (function () {
        var root = document.documentElement;
        var meta = document.querySelector('meta[name="theme-color"]');
        var toggles = document.querySelectorAll("[data-theme-toggle]");

        function sync() {
          var dark = root.classList.contains("dark");
          toggles.forEach(function (b) {
            b.setAttribute("aria-checked", String(dark));
          });
          if (meta) meta.content = dark ? "#24283b" : "#ffffff";
        }

        function apply(dark) {
          root.classList.toggle("dark", dark);
          sync();
        }

        toggles.forEach(function (b) {
          b.addEventListener("click", function () {
            var dark = !root.classList.contains("dark");
            try {
              localStorage.setItem("theme", dark ? "dark" : "light");
            } catch (e) {}
            var reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
            if (document.startViewTransition && !reduce) {
              document.startViewTransition(function () {
                apply(dark);
              });
            } else {
              apply(dark);
            }
          });
        });

        sync();
      })();

      // ---- copy email ----------------------------------------------------
      (function () {
        document.querySelectorAll("[data-copy-email]").forEach(function (b) {
          var done = b.querySelector(".done");
          var timer;
          b.addEventListener("click", function () {
            function show(text) {
              if (done) done.textContent = text;
              b.classList.add("ok");
              clearTimeout(timer);
              timer = setTimeout(function () {
                b.classList.remove("ok");
                if (done) done.textContent = "";
              }, 1400);
            }
            if (!navigator.clipboard) return show("copy failed");
            navigator.clipboard.writeText(b.dataset.copyEmail).then(
              function () {
                show("copied");
              },
              function () {
                show("copy failed");
              }
            );
          });
        });
      })();

      // ---- phone menu: a sheet under the top bar ------------------------
      // The page behind goes inert while it is open, so Tab stays in the
      // top bar and the sheet; Escape closes it and returns focus.
      (function () {
        var btn = document.getElementById("menuBtn");
        var sheet = document.getElementById("sheet");
        if (!btn || !sheet) return;
        var background = document.querySelectorAll("[data-inert-when-menu]");

        function isOpen() {
          return !sheet.hidden;
        }

        function set(open, restoreFocus) {
          sheet.hidden = !open;
          btn.setAttribute("aria-expanded", String(open));
          btn.setAttribute("aria-label", open ? "Close menu" : "Open menu");
          document.body.style.overflow = open ? "hidden" : "";
          background.forEach(function (el) {
            el.inert = open;
          });
          if (open) {
            var first = sheet.querySelector("a, button");
            if (first) first.focus();
          } else if (restoreFocus === "rail") {
            // the window grew past the sheet: hand focus to the desktop rail
            var rail = document.querySelector(".side a, .side button");
            if (rail) rail.focus();
          } else if (restoreFocus !== false) {
            btn.focus();
          }
        }

        btn.addEventListener("click", function () {
          set(!isOpen());
        });
        // A link that navigates or jumps in the page takes focus with it; a
        // new-tab or mailto link leaves the page where it was, so focus
        // returns to the menu button instead of dropping to <body>.
        sheet.querySelectorAll("a").forEach(function (a) {
          a.addEventListener("click", function () {
            var stays = a.target === "_blank" || /^mailto:/.test(a.getAttribute("href") || "");
            set(false, stays);
          });
        });
        var logo = document.querySelector("[data-topbar-logo]");
        if (logo)
          logo.addEventListener("click", function () {
            if (isOpen()) set(false, false);
          });
        document.addEventListener("keydown", function (e) {
          if (e.key === "Escape" && isOpen()) set(false);
        });
        // The sheet only exists below lg; growing the window past it must
        // not leave the page inert behind an invisible menu.
        window.matchMedia("(min-width: 1024px)").addEventListener("change", function (e) {
          if (e.matches && isOpen()) set(false, sheet.contains(document.activeElement) ? "rail" : false);
        });
      })();

      // ---- reveal on scroll --------------------------------------------
      (function () {
        var items = document.querySelectorAll(".reveal");
        if (!items.length) return;

        if (
          window.matchMedia("(prefers-reduced-motion: reduce)").matches ||
          !("IntersectionObserver" in window)
        ) {
          items.forEach(function (el) {
            el.classList.add("in");
          });
          return;
        }

        var io = new IntersectionObserver(
          function (entries) {
            entries.forEach(function (entry) {
              if (entry.isIntersecting) {
                entry.target.classList.add("in");
                io.unobserve(entry.target);
              }
            });
          },
          { rootMargin: "0px 0px -8% 0px", threshold: 0.05 }
        );

        items.forEach(function (el) {
          io.observe(el);
        });
      })();

      // ---- sidebar scrollspy (in-page links only) -----------------------
      (function () {
        var links = document.querySelectorAll("[data-spy]");
        if (!links.length) return;

        var map = {};
        links.forEach(function (a) {
          var href = a.getAttribute("href") || "";
          if (href.charAt(0) !== "#") return;
          var id = decodeURIComponent(href.slice(1));
          if (id) (map[id] = map[id] || []).push(a);
        });

        var current = null;
        function activate(id) {
          if (id === current) return;
          current = id;
          links.forEach(function (a) {
            a.removeAttribute("aria-current");
          });
          (map[id] || []).forEach(function (a) {
            a.setAttribute("aria-current", "true");
          });
        }

        // The current section is the last one whose top has passed 40% of
        // the window, or the last one outright once the page is at the
        // bottom (short last sections never reach that line). Recomputed on
        // every scroll, so tall sections and scrolling back up stay right.
        var targets = Object.keys(map)
          .map(function (id) {
            return document.getElementById(id);
          })
          .filter(Boolean)
          // Sidebar groups are not in page order, so sort by position.
          .sort(function (a, b) {
            return a.compareDocumentPosition(b) & Node.DOCUMENT_POSITION_FOLLOWING ? -1 : 1;
          });
        function update() {
          var line = window.innerHeight * 0.4;
          var atEnd = window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 2;
          var id = null;
          targets.forEach(function (el) {
            if (el.getBoundingClientRect().top <= line) id = el.id;
          });
          if (atEnd && targets.length) id = targets[targets.length - 1].id;
          if (id) activate(id);
        }
        var queued = false;
        window.addEventListener(
          "scroll",
          function () {
            if (queued) return;
            queued = true;
            requestAnimationFrame(function () {
              queued = false;
              update();
            });
          },
          { passive: true }
        );
        window.addEventListener("resize", update);
        update();
      })();
    </script>
  </body>
</html>
